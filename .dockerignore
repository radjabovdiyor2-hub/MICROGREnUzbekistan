# Build context excludes для ВСЕХ образов: apps/web, apps/bot и apps/tgas.
#
# Раньше tgas собирался с контекстом ./apps/tgas и пользовался собственным
# apps/tgas/.dockerignore. Контекст переехал в корень, чтобы образы офиса
# видели общий Python-пакет packages/mg_ai, — а значит здесь обязаны быть
# все исключения, которые раньше жили в apps/tgas/.dockerignore. Главное из
# них — apps/tgas/.env: там боевые токены всех ботов.

.git
.github
node_modules
**/node_modules
**/.next
**/.turbo
**/dist
**/build
**/__pycache__
**/*.pyc
**/*.pyo

# Logs & generated artifacts
*.log
logs/
*.tar
*.tar.gz
*.mp4
*.ogg
*.exe
temp_img.jpg
tree.txt

# Legacy stub left after moving tgas -> apps/tgas
tgas/

# Не нужно веб-образу; у офиса свой набор исключений ниже.
apps/game/

# ── apps/tgas: перенесено из apps/tgas/.dockerignore ──────────────────
# Он больше не применяется: контекст сборки офиса теперь корень репозитория.
# СЕКРЕТЫ — токены ботов приходят из env_file в рантайме, в образ не пекутся.
apps/tgas/.env
apps/tgas/.env.example
apps/tgas/venv/
apps/tgas/.venv/
# Рабочие данные, которым нечего делать в образе: файловая очередь задач,
# дампы базы, локальные sqlite.
apps/tgas/bus_tasks/
apps/tgas/backups/
apps/tgas/**/*.db
apps/tgas/.vscode/
apps/tgas/.gemini/
apps/tgas/.agents/
apps/tgas/**/*.md

# Dev-only: storybook, e2e tests, playwright
apps/web/.storybook/
apps/web/e2e/
apps/web/playwright.config.ts
apps/web/playwright-report/
apps/web/test-results/
**/*.stories.ts
**/*.stories.tsx

# design-system: dev tooling (token source, figma bundle, generator, docs) is
# excluded, BUT build/*.css is @imported by globals.css at build time, so the
# generated build output MUST stay in the context. The negations below override
# the broad `**/build` rule above.
apps/web/design-system/tokens/
apps/web/design-system/figma/
apps/web/design-system/build-tokens.mjs
apps/web/design-system/*.md
!apps/web/design-system/build/
!apps/web/design-system/build/**

# Never bake secrets into the storefront-bot image — runtime env_file provides them
apps/bot/.env
apps/bot/venv/
.env
.env.deploy

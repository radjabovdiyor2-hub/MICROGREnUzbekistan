# Build context excludes for the ROOT-context images (apps/web, apps/bot).
# The tgas image builds with context ./apps/tgas and uses apps/tgas/.dockerignore instead.

.git
.github
node_modules
**/node_modules
**/.next
**/.turbo
**/dist
**/build
**/__pycache__
**/*.pyc
**/*.pyo

# Logs & generated artifacts
*.log
logs/
*.tar
*.tar.gz
*.mp4
*.ogg
*.exe
temp_img.jpg
tree.txt

# Legacy stub left after moving tgas -> apps/tgas
tgas/

# Not needed by the web/bot images (tgas has its own build context; game is separate)
apps/tgas/
apps/game/

# Dev-only: storybook, design-system tooling, e2e tests, playwright
apps/web/.storybook/
apps/web/design-system/
apps/web/e2e/
apps/web/playwright.config.ts
apps/web/playwright-report/
apps/web/test-results/
**/*.stories.ts
**/*.stories.tsx

# Never bake secrets into the storefront-bot image — runtime env_file provides them
apps/bot/.env
apps/bot/venv/
.env
.env.deploy

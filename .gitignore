# Одноразовые скрипты доступа к серверу: держат хост, пользователя и учётные
# данные прода. Писались во время разбора аварии и остаются в рабочей копии —
# без этого правила первый же `git add .` утащит их в историю.
/execute_ssh.py
/ssh_*.py
/*_ssh.py

__pycache__/
.venv/
.test_venv/

# AI agent configs (Spec Kit skills/commands версионируются, локальные настройки — нет)
.gemini/*
!.gemini/commands/
.claude/*
!.claude/skills/
.claude-flow/

# One-off test/debug scripts in root
#
# Слэш в начале обязателен: без него шаблон срабатывает на ЛЮБОЙ глубине и
# проглатывает настоящий набор тестов — apps/tgas/tests/test_*.py не попадали
# в репозиторий вовсе. Локально они запускались и были зелёными, а на сервер
# и в CI не уезжали никогда. Правило задумано для одноразовых скриптов в
# корне, что и написано строкой выше, — таким оно теперь и стало.
/test_*.py
/verify_*.py
/test_bus_isolated_*/

# Misc
*.log
coverage/
.vercel/

# Temp scripts (never commit debug/deploy scripts to root)
_*.js
_*.py
!__init__.py
_*.log
_*.txt

# Generated docs/presentations (keep in docs/ or separate repo)
*.html
!apps/**/*.html
# Мастер-шаблон журнала — исходник, а не сгенерированный файл:
# без него scripts/build-magazine.mjs нечего собирать.
!content/templates/*.html

# Спецвыпуск «Shakar va tartib» — вёрстка руками, без шага apply-magazine-design.
# Лежит среди сгенерированных, но исходником является сам: перезаписывать его
# нечем, и без этой строки он потерялся бы при клоне.
!content/generated/shakar-01-print.html

# Макеты рекламных постеров — тоже исходники, верстаются руками.
# Их выгрузка (PNG/PDF) пересобирается из них же и не хранится: устаревший
# макет опаснее отсутствующего, его легко отправить в печать вместо нового.
!content/posters/*.html
content/posters/out/

# По той же причине не храним сборочный PDF номера и постраничные пруфы.
# В репозитории лежит только опубликованная копия apps/web/public/magazine/*.pdf —
# та, которую реально отдаёт сайт.
content/generated/*.pdf
content/generated/pages-*/


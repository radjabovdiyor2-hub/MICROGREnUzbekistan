node_modules/
.pnp
.pnp.js

# Build
.next/
out/
dist/
build/
*.tsbuildinfo

# Design-system token outputs: generated by `npm run tokens:build`, but COMMITTED
# so the app's CSS @imports resolve on a fresh clone without a build step.
# (Overrides the broad `build/` ignore above — parent dir is not ignored.)
!apps/web/design-system/build/
!apps/web/design-system/build/**

# Storybook static build output
storybook-static/

# Environment
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.deploy


# Keep Linux-consumed files as LF on every platform, so they work inside the
# Docker containers and on the deploy server (the deploy tars the working copy).
*.sh        text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
.dockerignore text eol=lf

# Spec Kit сверяет SHA-256 этих файлов с .specify/integrations/*.manifest.json.
# Конвертация в CRLF при checkout сломала бы проверку целостности на Windows.
.specify/**         text eol=lf
.claude/skills/**   text eol=lf
.gemini/commands/** text eol=lf
.agents/**          text eol=lf

# Microgreen Uzbekistan — Nginx Site Config (HTTP only, no SSL yet)
# Port 3002

upstream microgreen_app {
    server 127.0.0.1:3002;
}

server {
    server_name microgreenuzbekistan.com www.microgreenuzbekistan.com;

    client_max_body_size 10M;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /api/ {
        proxy_pass http://microgreen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /_next/static/ {
        proxy_pass http://microgreen_app;
        add_header Cache-Control "public, immutable, max-age=31536000";
    }

    location /uploads/ {
        alias /home/ubuntu/microgreen-uploads/;
        add_header Cache-Control "public, max-age=31536000";
    }

    location / {
        proxy_pass http://microgreen_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/microgreenuzbekistan.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/microgreenuzbekistan.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}


server {
    if ($host = www.microgreenuzbekistan.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = microgreenuzbekistan.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name microgreenuzbekistan.com www.microgreenuzbekistan.com;
    return 404; # managed by Certbot




}

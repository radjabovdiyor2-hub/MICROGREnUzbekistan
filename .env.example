# ============================================================================
#  Microgreen Uzbekistan — UNIFIED environment template
#  Copy to .env and fill in real values. Never commit .env.
#
#  Docker split:
#   - ROOT .env          -> POSTGRES_PASSWORD (single source of truth) + all
#                           website / storefront-bot keys (services: web, bot)
#   - apps/tgas/.env     -> all internal AI-office keys (13 tgas bots, OpenAI)
#  docker-compose.prod.yml builds every DATABASE_URL / REDIS_URL from the
#  values below, so keep POSTGRES_PASSWORD identical everywhere.
# ============================================================================

# ---------------------------------------------------------------------------
# INFRASTRUCTURE (shared)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change_me_strong_password
# Storefront DB (Prisma / apps/web). Compose overrides this at runtime; kept
# here for local (non-docker) development.
DATABASE_URL=postgresql://mg_user:change_me_strong_password@localhost:5432/microgreen_db
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# WEBSITE + STOREFRONT BOT  (apps/web, apps/bot — Gemini/Groq)
# ---------------------------------------------------------------------------
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
NEXT_PUBLIC_BOT_USERNAME=
ADMIN_CHAT_ID=
GROUP_ID=
WEB_APP_URL=https://microgreenuzbekistan.com/webapp
WEB_API_URL=https://microgreenuzbekistan.com/api
NEXT_PUBLIC_URL=https://microgreenuzbekistan.com

# AI (website + storefront bot)
GEMINI_API_KEY=
GROQ_API_KEY=

# Auth / secrets
JWT_SECRET=
BOT_SECRET=
ADMIN_PASSWORD=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@microgreenuzbekistan.com

# SMS (Eskiz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Payments — Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=

# Payments — Payme
PAYME_MERCHANT_ID=
PAYME_KEY=
NEXT_PUBLIC_PAYME_MERCHANT_ID=

# Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ===========================================================================
# The block below belongs in apps/tgas/.env (loaded by the tgas containers).
# Listed here for completeness; do NOT duplicate secrets between files.
# ===========================================================================

# --- tgas: Telegram bot tokens (9 department bots) -------------------------
STEPAN_BOT_TOKEN=
SALES_BOT_TOKEN=
SUPPORT_BOT_TOKEN=
MARKETING_BOT_TOKEN=
HR_BOT_TOKEN=
FINANCE_BOT_TOKEN=
PM_BOT_TOKEN=
ANALYTICS_BOT_TOKEN=
CONTENT_BOT_TOKEN=
# qa / rnd / devops / n8n_bridge are token-less workers (no Telegram bot)

# --- tgas: AI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- tgas: CRM DB (compose overrides at runtime) ----------------------------
# postgresql+asyncpg://mg_user:${POSTGRES_PASSWORD}@postgres:5432/microgreen

# --- tgas: company profile --------------------------------------------------
COMPANY_NAME=Microgreen Uzbekistan
COMPANY_PHONE=
COMPANY_WEBSITE=microgreenuzbekistan.com
COMPANY_CITY=Tashkent
CURRENCY=UZS
FREE_DELIVERY_THRESHOLD=
DELIVERY_FEE=

# --- tgas: admins & groups --------------------------------------------------
ADMIN_TELEGRAM_IDS=
SALES_GROUP_ID=

# --- tgas: Instagram / Facebook Graph --------------------------------------
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_VERIFY_TOKEN=

# --- tgas: email (SMTP) -----------------------------------------------------
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- tgas: n8n bridge -------------------------------------------------------
N8N_ASSISTANT_WEBHOOK=http://host.docker.internal:5678/webhook/assistant
N8N_TIMEOUT=120

# --- tgas: B2B lead-gen -----------------------------------------------------
DGIS_API_KEY=
GOOGLE_PLACES_API_KEY=
B2B_DAILY_LIMIT=15
LEAD_GEN_CITY=Tashkent

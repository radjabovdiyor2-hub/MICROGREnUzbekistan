# ============================================================================
#  Microgreen Uzbekistan — UNIFIED environment template
#  Copy to .env and fill in real values. Never commit .env.
#
#  Docker split:
#   - ROOT .env          -> POSTGRES_PASSWORD (single source of truth) + all
#                           website / storefront-bot keys (services: web, bot)
#   - apps/tgas/.env     -> all internal AI-office keys (12 tgas bots + bridge, OpenAI)
#  docker-compose.prod.yml builds every DATABASE_URL / REDIS_URL from the
#  values below, so keep POSTGRES_PASSWORD identical everywhere.
# ============================================================================

# ---------------------------------------------------------------------------
# INFRASTRUCTURE (shared)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change_me_strong_password
# Storefront DB (Prisma / apps/web). Compose overrides this at runtime; kept
# here for local (non-docker) development.
DATABASE_URL=postgresql://mg_user:change_me_strong_password@localhost:5432/microgreen_db
REDIS_URL=redis://localhost:6379/0
# Host dir mounted into the web container for uploaded product images (prod).
HOST_UPLOADS_DIR=/home/ubuntu/microgreen-uploads
# Shared secret for the storefront -> AI-office order bridge (web -> web_office
# /ingest/order + /ingest/order-status).
# ⚠️ REQUIRED in production. This used to say "leave empty to disable the check",
# but web_office rejects an empty secret when ENVIRONMENT=production (which
# docker-compose.prod.yml sets) — every /ingest/* call answers 401, and the
# storefront only logs the failure. The order lives on the site and the stock is
# deducted, while Stepan, sales, finance and analytics never hear about it.
# Set the SAME value on `web` and on the tgas bots. Empty is dev-only.
INGEST_SECRET=
# Shared secret for storefront-bot -> web admin API (apps/bot -> /api/admin/*).
# Empty = no check. Set the SAME value on the `web` and `bot` services to enforce.
# The same secret is used by the AI-office (apps/tgas) when it creates orders
# and changes their status through the storefront API.
BOT_SECRET=

# Where `web` pushes every created order so the AI-office CRM sees it.
# ⚠️ If this is unset, notifyOffice() silently skips: the order exists on the
# site, but neither the bots nor finance ever learn about it. In prod this is
# set by docker-compose.prod.yml; kept here so the variable is discoverable.
OFFICE_INGEST_URL=http://web_office:8050/ingest/order
OFFICE_STATUS_URL=http://web_office:8050/ingest/order-status
OFFICE_CUSTOMER_URL=http://web_office:8050/ingest/customer

# Storefront API as seen BY THE AI-OFFICE (apps/tgas -> apps/web).
# Orders are created only through it — see apps/tgas/shared/storefront_orders.py.
STOREFRONT_API_URL=http://web:3000/api

# Public HTTPS address of the storefront, used by the AI-office to build
# deep links into the admin panel (/admin?tab=…&focus=…) for Telegram buttons.
# STOREFRONT_API_URL above will NOT do: it is an internal docker address and
# Telegram requires a public HTTPS URL — see apps/tgas/shared/admin_links.py.
PUBLIC_WEB_URL=https://microgreenuzbekistan.com

# ---------------------------------------------------------------------------
# WEBSITE + STOREFRONT BOT  (apps/web, apps/bot — Gemini/Groq)
# ---------------------------------------------------------------------------
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
NEXT_PUBLIC_BOT_USERNAME=
ADMIN_CHAT_ID=
GROUP_ID=
WEB_APP_URL=https://microgreenuzbekistan.com/webapp
WEB_API_URL=https://microgreenuzbekistan.com/api
NEXT_PUBLIC_URL=https://microgreenuzbekistan.com

# AI (website + storefront bot)
# Ключ один на всё: web, бот витрины и ИИ-офис (web-контейнер грузит этот же
# .env через env_file). Модель по умолчанию — `gpt-5.5`, она же в коде
# (apps/web/src/lib/ai/models.ts, apps/tgas/shared/config.py).
OPENAI_API_KEY=
# ⚠️ ЗАДАННОЕ ЗДЕСЬ ЗНАЧЕНИЕ СИЛЬНЕЕ КОДА. Именно так офис и остался на
# `gpt-4o-mini`: в .env на сервере лежала эта строка, а дефолт в config.py
# правили, не заглядывая в неё. Хотите, чтобы модель решал код, — оставьте
# переменную ПУСТОЙ (пустая строка = «возьми дефолт», см. model_default_on_empty).
# Веб можно перевести на модель дешевле отдельно от офиса и бота: `gpt-5.4`
# ($2.50/$15 за 1M) или `gpt-5-mini` ($0.25/$2) против $5/$30 у 5.5. Новую
# модель добавляйте в оба прайса — apps/web/src/lib/ai/usage.ts и
# packages/mg_ai/mg_ai/engine.py, иначе расход считается по ставке наугад.
WEB_OPENAI_MODEL=
# Gemini остался ТОЛЬКО у веб-роутов журнала (apps/web/src/lib/magazine/ai.ts)
# как запасной генератор текста. У ИИ-офиса запасного движка больше нет: тихая
# подмена модели неотличима от работающего движка — именно из-за неё офис
# месяцами отвечал слабой моделью.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=

# Журнал: адрес web_office для Google Trends в «Брифинге недели»
# (apps/web/src/app/api/admin/magazine/brief/route.ts). В проде задаётся
# явно в docker-compose (http://web_office:8050); дефолт кода — localhost:8050.
WEB_OFFICE_URL=

# Auth / secrets
# BOT_SECRET объявлен выше, в блоке общих секретов — второго объявления здесь
# больше нет: при загрузке .env побеждало последнее, и пустая строка отсюда
# молча затирала заданное значение.
#
# Ключ подписи сессий (lib/session.ts). Им подписаны и вход в админку, и
# сессия покупателя, по которой личный кабинет узнаёт владельца заказов.
# Минимум 16 символов; в проде без него вход отключается совсем (fail closed).
# JWT_SECRET принимается как запасное имя — задавайте что-то одно.
SESSION_SECRET=
JWT_SECRET=
ADMIN_PASSWORD=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@microgreenuzbekistan.com

# SMS (Eskiz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Payments — Click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=

# Payments — Payme
PAYME_MERCHANT_ID=
PAYME_KEY=
NEXT_PUBLIC_PAYME_MERCHANT_ID=

# Monitoring (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Web analytics — счётчики включаются, как только заданы ID (runtime, без пересборки)
# Яндекс Метрика: номер счётчика (только цифры)
YM_ID=
# Google Analytics 4: G-XXXXXXXXXX
GA_ID=

# ===========================================================================
# The block below belongs in apps/tgas/.env (loaded by the tgas containers).
# Listed here for completeness; do NOT duplicate secrets between files.
# ===========================================================================

# --- tgas: Telegram bot tokens (9 department bots) -------------------------
STEPAN_BOT_TOKEN=
SALES_BOT_TOKEN=
SUPPORT_BOT_TOKEN=
MARKETING_BOT_TOKEN=
HR_BOT_TOKEN=
FINANCE_BOT_TOKEN=
# PM_BOT_TOKEN — переменная-призрак: отдельного pm_bot нет (порт 8087
# исторически зарезервирован), и ни одна строка Python её не читает.
# Роль PM исполняет Стёпан. Оставлена пустой, чтобы не плодить миф о 13 ботах.
PM_BOT_TOKEN=
ANALYTICS_BOT_TOKEN=
CONTENT_BOT_TOKEN=
# qa / rnd / devops / n8n_bridge are token-less workers (no Telegram bot)

# --- tgas: AI ---------------------------------------------------------------
# ⚠️ OPENAI_API_KEY — ЕДИНСТВЕННЫЙ движок ИИ-офиса. Запасного больше нет:
# раньше пустой ключ не «выключал OpenAI», а молча переводил все 12 ботов на
# Gemini Flash, и месяцы работы на слабой модели выглядели как «бот тупой».
# Теперь отказ виден — сигналом владельцу и красной сверкой:
#   cd apps/tgas && python scripts/check_ai.py
OPENAI_API_KEY=
# Пусто = значение по умолчанию из shared/config.py (единственный источник).
# Там `gpt-5.5` ($5/$30 за 1M) — самая умная из доступных по обычному ключу.
# Дешевле: `gpt-5.4` ($2.50/$15), `gpt-5-mini` ($0.25/$2).
# ⚠️ `gpt-5.6-*` — закрытое превью OpenAI, по обычному ключу даёт 400.
# ⚠️ Эту же переменную читает клиентский бот витрины (docker-compose.prod.yml,
# сервис `bot`), а он отвечает КАЖДОМУ покупателю. Меняя модель здесь,
# помните про его объём: у офиса десятки сообщений в день, у витрины — все.
# Новую модель добавляйте и в TOKEN_COSTS (packages/mg_ai/mg_ai/engine.py),
# иначе расход в админке считается по ставке наугад.
OPENAI_MODEL=

# --- tgas: CRM DB (compose overrides at runtime) ----------------------------
# postgresql+asyncpg://mg_user:${POSTGRES_PASSWORD}@postgres:5432/microgreen

# --- tgas: company profile --------------------------------------------------
COMPANY_NAME=Microgreen Uzbekistan
COMPANY_PHONE=
COMPANY_WEBSITE=microgreenuzbekistan.com
COMPANY_CITY=Tashkent
CURRENCY=UZS
FREE_DELIVERY_THRESHOLD=
DELIVERY_FEE=

# --- tgas: admins & groups --------------------------------------------------
ADMIN_TELEGRAM_IDS=
SALES_GROUP_ID=

# The SAME ids, as seen by the storefront (apps/web). They let the owner open
# the admin panel straight from a Telegram button without a password:
# /api/auth/telegram-admin verifies the Mini App signature and issues an ADMIN
# session only for ids listed here. Empty = that door stays shut (password only).
# Keep in sync with ADMIN_TELEGRAM_IDS above — they answer the same question.
OWNER_TELEGRAM_IDS=

# --- tgas: Instagram / Facebook Graph --------------------------------------
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Верификация вебхука Meta (web_office /webhooks/meta). Не задан — верификации
# нет: раньше здесь подставлялось значение по умолчанию прямо из кода, то есть
# вебхук подтверждал кто угодно, кто прочитал репозиторий.
META_VERIFY_TOKEN=

# --- web: WhatsApp Business (Meta) -----------------------------------------
# Токен верификации вебхука (GET /api/whatsapp/webhook). Пусто = дверь закрыта.
WHATSAPP_VERIFY_TOKEN=
# Секрет приложения для проверки подписи X-Hub-Signature-256 на POST.
# Без него «сообщением от клиента» может прикинуться кто угодно, поэтому
# при пустом значении вебхук отвечает 403. Если приложение то же, что у
# Instagram/Facebook — подойдёт FACEBOOK_APP_SECRET выше.
WHATSAPP_APP_SECRET=

# --- tgas: email (SMTP) -----------------------------------------------------
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- tgas: n8n bridge -------------------------------------------------------
N8N_ASSISTANT_WEBHOOK=http://host.docker.internal:5678/webhook/assistant
N8N_TIMEOUT=120

# --- tgas: B2B lead-gen + геокодирование карты клиентов ---------------------
# Ключ 2ГИС нужен ДВАЖДЫ: он собирает рестораны-лиды и он же первый в каскаде
# геокодеров (apps/tgas/shared/geo.py). Без него карта клиентов не заполнится:
# `geocode_pass` вернёт «Ни один геокодер не настроен».
#
# Доезжает до офиса через docker-compose.prod.yml (якорь x-tgas-bot), а туда —
# из этого файла. В проде значение пишет деплой из GitHub Secrets.
DGIS_API_KEY=
# Второй в каскаде. По Узбекистану покрытие слабее, чем у 2ГИС.
YANDEX_GEOCODER_API_KEY=
# Публичный Nominatim (OSM) — только для разработки, условия OSMF запрещают
# массовое коммерческое использование. 1 = включить.
GEOCODER_ALLOW_NOMINATIM=0
GOOGLE_PLACES_API_KEY=
B2B_DAILY_LIMIT=15
LEAD_GEN_CITY=Tashkent

# ============================================================================
#  Переменные, которые код читает, но которые нигде не были объявлены.
#
#  Их отсутствие не заметно при чтении кода: там всё правильно. Заметно оно
#  только в проде — молча выключенной функцией. Сторож `scripts/check_env_declared.py`
#  теперь не даёт добавить новую такую переменную.
# ============================================================================

# -------- Витрина (web) --------
# Заранее посчитанный scrypt-хеш пароля владельца. Альтернатива ADMIN_PASSWORD:
# читается вторым, если нет файла .admin-password.json (см. lib/password.ts).
ADMIN_PASSWORD_HASH=
# Ключ HMAC-цепочки журнала аудита. Пустой = цепочка не подписывается, то есть
# доказать неизменность журнала нечем — а он ради этого и ведётся.
AUDIT_SECRET=
# Куда писать журнал аудита. В проде — том (см. STATE_DIR в compose), иначе
# logs/ рядом с процессом, и деплой стирает журнал вместе со слоем образа.
AUDIT_LOG_DIR=
# Каталог для пароля владельца и passkeys. В проде смонтирован томом.
STATE_DIR=
# Домен для WebAuthn (passkeys). Без него привязка ключа не пройдёт проверку.
WEBAUTHN_RP_ID=
# Секрет крона маркетинговых рассылок. Пустой = ожидаемый заголовок равен
# литералу "Bearer undefined", который может прислать кто угодно.
CRON_SECRET=
# ID Telegram-канала для публикаций из админки.
CHANNEL_ID=
# Счётчики аналитики (публичные, попадают в браузер).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Векторные тайлы карты клиентов в админке. По умолчанию OpenFreeMap:
# без ключа, без лимитов, коммерческое использование разрешено.
# Меняется на свой tileserver-gl — тогда внешних запросов не остаётся вовсе.
# ВАЖНО: этот же origin подставляется в connect-src (src/middleware.ts),
# поэтому менять адрес достаточно здесь — CSP подтянется сам.
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org
# Адрес AI-офиса для админского workflow. Первый в цепочке; работает и без
# него — за счёт fallback на WEB_OFFICE_URL.
TGAS_OFFICE_URL=

# -------- Витринный бот (bot) --------
# Публичный адрес сайта: из него бот строит абсолютные ссылки на картинки.
WEB_URL=https://microgreenuzbekistan.com
# Группа, куда падают новые заказы из бота.
ORDER_GROUP_ID=
# Кампания возврата неактивных клиентов (18:00, до 20 сообщений в день).
# ⚠️ Пишет РЕАЛЬНЫМ клиентам. Пусто/false = выключена. Включать осознанно.
REENGAGE_ENABLED=
# Каталог обложек и PDF журнала. По умолчанию ищется рядом с кодом.
MAGAZINE_CONTENT_DIR=
# WhatsApp Cloud API — без них модуль WhatsApp просто молчит.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

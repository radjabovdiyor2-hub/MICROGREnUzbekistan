# ═══════════════════════════════════════════════════════
# Microgreen Uzbekistan — Production Environment
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://microgreen:YOUR_PASSWORD@localhost:5432/microgreen_db"
POSTGRES_PASSWORD="YOUR_PASSWORD"

# ─── Telegram Bot ──────────────────────────────────────
BOT_TOKEN="YOUR_BOT_TOKEN"
ADMIN_CHAT_ID="847872669"
GROUP_ID="@mcgprdj"

# ─── URLs ──────────────────────────────────────────────
WEB_APP_URL="https://microgreenuzbekistan.com"
WEB_API_URL="https://microgreenuzbekistan.com/api"

# ─── AI ────────────────────────────────────────────────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# ─── Payments ──────────────────────────────────────────
PAYME_MERCHANT_ID=""
PAYME_KEY=""
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# ─── Security ──────────────────────────────────────────
BOT_SECRET="YOUR_BOT_SECRET"
ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# ─── Node.js (auto-set by PM2) ────────────────────────
# NODE_ENV=production
# PORT=3000

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; musl-openssl-3.0.x = the node:20-alpine runtime image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ==========================================
// Microgreen — Xo'jalik Do'koni Database Schema
// ==========================================

model Category {
  id       String     @id @default(cuid())
  nameUz   String     @map("name_uz")
  nameRu   String     @map("name_ru")
  slug     String     @unique
  icon     String?
  image    String?
  order    Int        @default(0)
  parentId String?    @map("parent_id")
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())
  nameUz        String   @map("name_uz")
  nameRu        String   @map("name_ru")
  slug          String   @unique
  descriptionUz String?  @map("description_uz") @db.Text
  descriptionRu String?  @map("description_ru") @db.Text
  price         Int // Цена в сумах
  oldPrice      Int?     @map("old_price")
  costPrice     Int?     @map("cost_price") // Закупочная цена (от поставщика)

  /// За что назначена цена: «лоток», «100 г», «кг», «шт».
  ///
  /// Единица у категорий РАЗНАЯ: микрозелень продаётся за лоток, бейби-лист
  /// за 100 грамм, салаты за килограмм. Без этого поля «Фризе — 200 000 сум»
  /// на витрине читается как цена за один кочан, и клиент уходит, решив, что
  /// это дорого. Цена без единицы вводит в заблуждение сильнее, чем её
  /// отсутствие.
  ///
  /// До этого единицу тянул подзапросом офисный `catalog_repo` из зеркала
  /// `crm_products` по `storefront_id`, а без зеркальной строки честно отдавал
  /// `piece`. Витрина владеет своим товаром — единица живёт здесь.
  unit          String   @default("шт") @db.VarChar(20)
  images        String[] // URLs
  categoryId    String   @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  stock         Int      @default(0)
  sku           String?  @unique
  brand         String?
  specs         Json? // Характеристики
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  isActive      Boolean  @default(true) @map("is_active")
  isFeatured    Boolean  @default(false) @map("is_featured")
  isOnSale      Boolean  @default(false) @map("is_on_sale")
  viewCount     Int      @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems        OrderItem[]
  cartItems         CartItem[]
  favorites         Favorite[]
  reviews           Review[]
  stockMovements    StockMovement[]
  recipeIngredients RecipeIngredient[]
  greenBoxItems     GreenBoxItem[]

  @@index([categoryId])
  @@index([categoryId, isActive])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@map("products")
}

model User {
  id           String  @id @default(cuid())
  telegramId   BigInt? @unique @map("telegram_id")
  phone        String? @unique
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  username     String?
  avatarUrl    String? @map("avatar_url")
  language     String  @default("uz")
  theme        String  @default("system") // light | dark | system
  bonusPoints  Int     @default(0) @map("bonus_points")
  referralCode String  @unique @default(cuid()) @map("referral_code")
  referredBy   String? @map("referred_by")
  role         Role    @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders                Order[]
  cart                  CartItem[]
  favorites             Favorite[]
  reviews               Review[]
  addresses             Address[]
  aiChats               AiChat[]
  greenBoxSubscriptions GreenBoxSubscription[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
  MODERATOR
  SELLER
}

model Address {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String? // "Uy", "Ish", etc.
  fullAddress String  @map("full_address")
  city        String  @default("tashkent")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("addresses")
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart_items")
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("favorites")
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique @map("order_number")
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  total         Int           @map("total_amount")
  subtotal      Int
  deliveryFee   Int           @default(0) @map("delivery_fee")
  discount      Int           @default(0)

  // ── Из чего сложилась скидка ──
  // `discount` — СУММА бонусов и промокода, и разделить её обратно нельзя.
  // Из-за этого отменённый заказ не мог вернуть ни баллы клиенту, ни
  // использование промокода: было неизвестно, сколько чего списали.
  /// Сколько бонусных баллов списано при оформлении.
  bonusUsed Int     @default(0) @map("bonus_used")
  /// Применённый промокод — чтобы при отмене освободить его использование.
  promoCode String? @map("promo_code")

  city          String        @default("tashkent")
  address       String
  phone         String
  note          String?       @db.Text
  paymentMethod String        @map("payment_method") // click | payme | cash
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  isSubscription Boolean @default(false) @map("is_subscription")

  items        OrderItem[]
  DeliveryStop DeliveryStop[]

  // Composite indexes for the hot list queries (newest-first pagination):
  // admin list by status, a customer's own orders, and lookup by phone.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@index([orderNumber])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int // Цена на момент заказа

  @@map("order_items")
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  // percent (value = 1..100) | fixed (value = сумма в сумах)
  discountType String    @default("percent") @map("discount_type")
  value        Int
  minSubtotal  Int       @default(0) @map("min_subtotal")
  maxUses      Int?      @map("max_uses")
  usedCount    Int       @default(0) @map("used_count")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("promo_codes")
}

model Review {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model AiChat {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String // user | assistant
  content  String @db.Text
  metadata Json? // Recommended products, etc.

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ai_chats")
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  discount    Int? // Percentage
  promoCode   String?  @unique @map("promo_code")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("promotions")
}

// ==========================================
// EMPLOYEE (SELLER) SYSTEM
// ==========================================

model Employee {
  city        String    @default("tashkent")
  id         String    @id @default(cuid())
  name       String
  pin        String    @unique // 4-digit PIN for POS login
  phone      String?
  telegramId BigInt?   @unique @map("telegram_id")
  department String? // e.g. marketing, content, hr, etc.
  isActive   Boolean   @default(true) @map("is_active")
  role       String    @default("seller") // seller | manager
  birthDate  DateTime? @map("birth_date") @db.Date
  baseSalary Int?      @map("base_salary") // UZS

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shifts         Shift[]
  DeliveryRoute  DeliveryRoute[]
  QualityControl QualityControl[]

  @@map("employees")
}

model Shift {
  id         String    @id @default(cuid())
  employeeId String    @map("employee_id")
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  startTime  DateTime? @map("start_time")
  endTime    DateTime? @map("end_time")
  type       String    @default("work") // work | sick | vacation
  note       String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@index([date])
  @@map("shifts")
}

// ==========================================
// INVENTORY MANAGEMENT SYSTEM
// ==========================================

model StockMovement {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        MovementType
  quantity    Int // Positive for IN, negative for OUT
  reason      String? // "Продажа", "Поставка", "Списание", "Возврат", etc.
  note        String?      @db.Text
  supplierId  String?      @map("supplier_id")
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  costPrice   Int?         @map("cost_price") // Закупочная цена за единицу
  salePrice   Int?         @map("sale_price") // Фактическая цена продажи (если отличается от product.price)
  orderId     String?      @map("order_id") // Привязка к заказу если продажа
  performedBy String?      @map("performed_by") // Кто провёл операцию

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

enum MovementType {
  IN // Приход товара
  OUT // Продажа/расход
  ADJUSTMENT // Корректировка (инвентаризация)
  RETURN // Возврат от клиента
  WRITE_OFF // Списание (брак, порча)
}

model Supplier {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  address  String?
  note     String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]
  debts          Debt[]
  prices         SupplierPrice[]
  materialIntake RawMaterialMovement[]

  @@map("suppliers")
}

// ══════════════════════════════════════════════════════════════════════
// ПРОИЗВОДСТВЕННЫЙ ЦИКЛ: сырьё → посадка → урожай → товар
//
// До этих таблиц цикла в базе не было. Поставщик был телефонной книгой без
// прайсов; семена, субстрат и лотки не учитывались нигде (таблица `inventory`
// осталась от офиса: её только списывали, пополнить было нечем и из витрины
// к ней не было доступа); норм расхода не существовало, а `cost_price` партии
// молча терялся при создании — поэтому «Просрочено N (убыток 0 сум)» на
// «Сводке» всегда показывал ноль, каким бы ни был убыток.
// ══════════════════════════════════════════════════════════════════════

enum RawMaterialKind {
  SEED // Семена — расходуются по норме на лоток
  SUBSTRATE // Субстрат/грунт
  TRAY // Лотки
  PACKAGING // Упаковка
  OTHER
}

enum RawMaterialMovementType {
  IN // Приход от поставщика
  CONSUME // Расход на посадку
  WRITE_OFF // Порча, просрочка
  ADJUSTMENT // Инвентаризация
}

/// Сырьё и расходники. Отдельно от `products`: товар продаётся штуками и
/// имеет цену продажи, сырьё расходуется граммами и имеет только себестоимость.
model RawMaterial {
  id   String          @id @default(cuid())
  name String
  kind RawMaterialKind @default(OTHER)

  /// g | kg | pcs | l — в чём меряем остаток и норму расхода.
  unit String @default("g") @db.VarChar(10)

  stock Decimal @default(0) @db.Decimal(12, 3)

  /// Средневзвешенная себестоимость единицы. Пересчитывается при каждом
  /// приходе: (остаток × старая + приход × цена) / (остаток + приход).
  /// Так цена не скачет вместе с рынком при каждой закупке.
  avgCost Decimal @default(0) @map("avg_cost") @db.Decimal(12, 2)

  /// Порог предупреждения «скоро закончится».
  minStock Decimal @default(0) @map("min_stock") @db.Decimal(12, 3)

  /// Для семян — культура из CropNorm. По ней посадка находит, что списывать.
  cropType String? @map("crop_type") @db.VarChar(50)

  isActive Boolean @default(true) @map("is_active")
  note     String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  movements RawMaterialMovement[]
  prices    SupplierPrice[]

  /// Нормы культур, которые явно закреплены за этим субстратом.
  cropNorms CropNorm[] @relation("CropNormSubstrate")

  @@index([kind])
  @@index([cropType])
  @@index([isActive])
  @@map("raw_materials")
}

/// Журнал сырья: приход, расход на посадку, списание, инвентаризация.
/// Остаток `RawMaterial.stock` меняется только вместе с записью сюда.
model RawMaterialMovement {
  id         String                  @id @default(cuid())
  materialId String                  @map("material_id")
  material   RawMaterial             @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type       RawMaterialMovementType

  /// Со знаком: приход положительный, расход отрицательный.
  quantity Decimal @db.Decimal(12, 3)

  /// Цена закупки за единицу — только у прихода.
  unitCost  Decimal? @map("unit_cost") @db.Decimal(12, 2)
  totalCost Decimal? @map("total_cost") @db.Decimal(14, 2)

  supplierId String?    @map("supplier_id")
  supplier   Supplier?  @relation(fields: [supplierId], references: [id])
  /// Расход привязан к партии — по нему считается её себестоимость.
  growBatchId String?   @map("grow_batch_id")
  growBatch   GrowBatch? @relation(fields: [growBatchId], references: [id])

  reason      String?
  performedBy String? @map("performed_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([materialId])
  @@index([type])
  @@index([growBatchId])
  @@index([createdAt])
  @@map("raw_material_movements")
}

/// Прайс поставщика на сырьё. Владелец правит цены под рынок; приход
/// подставляет актуальную и предлагает обновить, если фактическая другая.
model SupplierPrice {
  id         String      @id @default(cuid())
  supplierId String      @map("supplier_id")
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  materialId String      @map("material_id")
  material   RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  price Decimal @db.Decimal(12, 2)
  unit  String  @db.VarChar(10)

  validFrom DateTime @default(now()) @map("valid_from")
  isActive  Boolean  @default(true) @map("is_active")
  note      String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([supplierId, materialId, validFrom])
  @@index([materialId, isActive])
  @@map("supplier_prices")
}

/// Нормы культуры: сколько сырья уходит на единицу посадки и сколько с неё
/// снимают. Длительности фаз переезжают сюда из CROP_DB (жили в коде
/// фронтенда, и изменить их без правки кода было нельзя).
///
/// ДВА СПОСОБА ПОСАДКИ
///
/// Микрозелень растят в ЛОТКАХ на кокосовом субстрате: норма — граммы на
/// лоток (стандарт 150 г субстрата). Салаты растят ПОШТУЧНО в стаканчиках
/// 63 мм на агро вате: норма — штуки семян и одна пробка ваты на стаканчик,
/// а сами стаканчики многоразовые и на складе не ведутся.
///
/// Поэтому поля называются `...PerUnit`, а не `...PerTray`: единица задаётся
/// в `plantingUnit`. Имя `seedGramsPerTray`, в котором лежат «штуки семян на
/// стаканчик», врало бы о содержимом — ровно тот сорт лжи, из-за которого в
/// этом проекте уже ловили дорогие ошибки. Колонки в базе прежние (`@map`),
/// миграции данных нет.
model CropNorm {
  id       String @id @default(cuid())
  cropType String @unique @map("crop_type") @db.VarChar(50)
  nameRu   String @map("name_ru") @db.VarChar(100)

  /// `tray` — лоток микрозелени, `cup` — стаканчик салата.
  plantingUnit String @default("tray") @map("planting_unit") @db.VarChar(10)

  /// В чём считается расход семян: `g` (граммы на лоток) или `pcs`
  /// (штуки семян на стаканчик).
  seedUnit String @default("g") @map("seed_unit") @db.VarChar(10)

  /// Те самые «5-6 грамм на лоток» — или штуки семян на стаканчик,
  /// смотря что стоит в `seedUnit`.
  seedPerUnit Decimal @map("seed_grams_per_tray") @db.Decimal(10, 2)

  /// Кокос в граммах на лоток либо пробка ваты в штуках на стаканчик.
  substratePerUnit Decimal? @map("substrate_grams_per_tray") @db.Decimal(10, 2)

  /// КАКОЙ ИМЕННО субстрат. Без этой привязки посадка выбирала «первый
  /// активный субстрат, самый старый» — кокос и агро вата были для кода
  /// неразличимы, и при двух позициях любая посадка списывала бы ту, что
  /// заведена раньше: у салата неверная себестоимость, вата вечно в остатке,
  /// и ни ошибки, ни предупреждения.
  substrateMaterialId String?       @map("substrate_material_id")
  substrateMaterial   RawMaterial?  @relation("CropNormSubstrate", fields: [substrateMaterialId], references: [id])

  /// Сколько лотков уходит на одну единицу посадки. Лотки одноразовые, поэтому
  /// по умолчанию 1. Раньше тип «Лотки» существовал в справочнике сырья, но
  /// посадка его не списывала вовсе — себестоимость партии выходила заниженной
  /// на стоимость лотков, и заметить это было нельзя.
  ///
  /// Для стаканчиков здесь должен стоять 0: иначе посадка 250 стаканчиков
  /// спишет 250 лотков.
  traysPerBatch Decimal @default(1) @map("trays_per_batch") @db.Decimal(10, 2)

  /// Упаковка списывается при СБОРЕ, а не при посадке: упаковывают готовый
  /// урожай. Норма задана на единицу, расход считается от фактического сбора.
  packagingPerUnit Decimal? @map("packaging_per_tray") @db.Decimal(10, 2)

  /// Ожидаемый выход с единицы — по нему считается плановая себестоимость
  /// и видно отклонение факта от нормы.
  yieldPerUnit Decimal? @map("yield_per_tray") @db.Decimal(10, 2)

  darkDays  Int @default(3) @map("dark_days")
  lightDays Int @default(6) @map("light_days")
  shelfDays Int @default(5) @map("shelf_days")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([substrateMaterialId])
  @@map("crop_norms")
}

model Debt {
  id          String    @id @default(cuid())
  type        DebtType // WHO_OWES_US = нам должны, WE_OWE = мы должны
  personName  String    @map("person_name")
  phone       String?
  amount      Int // Сумма долга в сумах
  paidAmount  Int       @default(0) @map("paid_amount") // Сколько уже оплачено
  description String?   @db.Text
  dueDate     DateTime? @map("due_date")
  isPaid      Boolean   @default(false) @map("is_paid")
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  userId      String?   @map("user_id") // Привязка к клиенту

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([isPaid])
  @@map("debts")
}

enum DebtType {
  WHO_OWES_US // Клиент должен нам
  WE_OWE // Мы должны поставщику
}

// ==========================================
// MAGAZINE SYSTEM (FRESH WEEKLY)
// ==========================================

model MagazineSubscriber {
  id      String  @id @default(cuid())
  userId  String? @map("user_id")
  phone   String?
  type    String  @default("digital") // digital | print
  address String? // Для печатной версии (print-on-demand)
  isPaid  Boolean @default(false) @map("is_paid")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("magazine_subscribers")
}

// ==========================================
// RESTAURANT DATABASE (100 ресторанов для AI Sales Bot)
// ==========================================

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  city        String // "tashkent" | "samarkand"
  cuisine     String[] // ["european", "japanese", "uzbek"]
  tier        String // "premium" | "traditional" | "cafe" | "tourist"
  dishes      String[] // Ключевые блюда
  microgreens String[] // Рекомендуемая микрозелень
  flowers     String[] // Рекомендуемые съедобные цветы
  isPartner   Boolean  @default(false) @map("is_partner")
  contactName String?  @map("contact_name")
  phone       String?
  note        String?  @db.Text

  // ── FRESH WEEKLY: HoReCa Edition (индивидуализация журнала) ──
  slug              String?  @unique
  logo              String? // /uploads/... логотип ресторана
  instagram         String? // @handle (ввод вручную, без парсинга)
  brandPrimary      String?  @map("brand_primary") // фирменный цвет #hex → --accent
  brandAccent       String?  @map("brand_accent") // акцентный цвет #hex → --gold
  promoCode         String?  @map("promo_code") // код для семейного QR-блока
  promoDiscount     Int?     @map("promo_discount") // % скидки
  menuItems         String[] @map("menu_items") // блюда меню для контекста ИИ
  isMagazinePartner Boolean  @default(false) @map("is_magazine_partner")

  // Готовый журнал: PDF/HTML загружается владельцем через админку
  magazinePdfUrl  String? @map("magazine_pdf_url")
  magazineHtmlUrl String? @map("magazine_html_url")

  // Карта лояльности: N штампов (за кадры) → промокод в магазин микрозелени
  loyaltyGoal          Int? @default(5) @map("loyalty_goal")
  loyaltyRewardPercent Int? @default(15) @map("loyalty_reward_percent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  magazineIssues     RestaurantIssue[]
  printSubscriptions PrintSubscription[]
  menuDishes         Dish[]
  guestPhotos        GuestPhoto[]
  loyaltyCards       LoyaltyCard[]

  @@index([city])
  @@index([isPartner])
  @@map("restaurants")
}

// Карта лояльности гостя (без регистрации: ключ — sessionId).
// Штамп даётся за снятый кадр блюда, максимум один в день.
model LoyaltyCard {
  id            String     @id @default(cuid())
  restaurantId  String     @map("restaurant_id")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessionId     String     @map("session_id")
  stamps        Int        @default(0)
  // YYYY-MM-DD последнего штампа — гейт «один штамп в день»
  lastStampedOn String?    @map("last_stamped_on")
  // Промокод-награда, выданный при достижении цели (в магазин микрозелени)
  rewardCode    String?    @map("reward_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([restaurantId, sessionId])
  @@index([restaurantId])
  @@map("loyalty_cards")
}

// ==========================================
// FRESH WEEKLY — Персональные выпуски (схема 50/50)
// ==========================================

// Общий 50%: генерится раз в неделю, одинаков для всех ресторанов
model MagazineEdition {
  id          String    @id @default(cuid())
  weekNumber  Int       @unique @map("week_number")
  title       String
  coverTheme  String?   @map("cover_theme")
  sharedSpec  Json      @default("{}") @map("shared_spec") // { blocks: Block[] }
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issues RestaurantIssue[]

  @@map("magazine_editions")
}

// Персональный 50%: слово шефа, обложка, семейный блок — на каждый ресторан
model RestaurantIssue {
  id           String          @id @default(cuid())
  editionId    String          @map("edition_id")
  edition      MagazineEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  restaurantId String          @map("restaurant_id")
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  spec         Json            @default("{}") // { blocks: Block[] }
  status       String          @default("draft") // draft | ready | published
  webSlug      String          @unique @map("web_slug")
  pdfUrl       String?         @map("pdf_url")
  htmlUrl      String?         @map("html_url")
  publishedAt  DateTime?       @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  printOrders PrintOrder[]

  @@unique([editionId, restaurantId])
  @@index([restaurantId])
  @@map("restaurant_issues")
}

// ==========================================
// ADVERTISERS (B2B Sponsors & Partners)
// ==========================================

model Advertiser {
  id            String  @id @default(cuid())
  companyName   String  @map("company_name")
  contactPerson String? @map("contact_person")
  phone         String?
  email         String?
  status        String  @default("lead") // lead | active | past
  format        String? // cover_ar | spread | page
  notes         String? @db.Text
  amount        Int? // сумма контракта в сумах или USD

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("advertisers")
}

// ==========================================
// FRANCHISE MODULE (Multi-city AI Management)
// ==========================================

model FranchiseJournal {
  id         String @id @default(cuid())
  city       String // 'samarkand', 'bukhara', 'fergana'
  department String // 'sales', 'finance', 'pm', 'analytics'
  action     String // Краткое описание действия
  content    String @db.Text // Развернутый текст от ИИ-бота
  metrics    Json? // Структурированные данные (выручка, расходы и т.д.)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([city, createdAt])
  @@map("franchise_journals")
}

// ==========================================
// PRINT CENTER (Phase 4)
// ==========================================

model PrintSubscription {
  id             String       @id @default(cuid())
  restaurantId   String       @map("restaurant_id")
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan           String       @default("weekly") // weekly | biweekly | monthly
  copiesPerIssue Int          @map("copies_per_issue")
  pricePerCopy   Int          @map("price_per_copy") // цена ресторану за копию, UZS
  unitCost       Int          @default(0) @map("unit_cost") // себестоимость печати копии, UZS
  status         String       @default("active") // active | paused | cancelled
  startedAt      DateTime     @default(now()) @map("started_at")
  nextBillingAt  DateTime?    @map("next_billing_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  orders         PrintOrder[]

  @@index([restaurantId])
  @@map("print_subscriptions")
}

model PrintOrder {
  id                String             @id @default(cuid())
  restaurantIssueId String             @map("restaurant_issue_id")
  restaurantIssue   RestaurantIssue    @relation(fields: [restaurantIssueId], references: [id], onDelete: Cascade)
  subscriptionId    String?            @map("subscription_id")
  subscription      PrintSubscription? @relation(fields: [subscriptionId], references: [id])
  copies            Int
  unitCost          Int                @map("unit_cost")
  unitPrice         Int                @map("unit_price")
  revenue           Int // unitPrice * copies
  cost              Int // unitCost * copies
  margin            Int // revenue - cost
  status            String             @default("pending") // pending | paid | printing | shipped | delivered
  paymentProvider   String?            @map("payment_provider") // click | payme | cash
  paidAt            DateTime?          @map("paid_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([restaurantIssueId])
  @@map("print_orders")
}

// ── Аналитика журнала ──
model MagazineEvent {
  id        String   @id @default(cuid())
  type      String // page_view | qr_scan | dish_view | frame_open | photo_submitted | photo_shared
  slug      String? // webSlug выпуска (если применимо)
  dishId    String?  @map("dish_id") // id блюда (для событий меню)
  sessionId String   @map("session_id") // fingerprint сессии (анонимный)
  meta      Json? // доп. данные (язык, userAgent, и т.д.)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([slug])
  @@map("magazine_events")
}

// ── Живое меню: блюда ресторана ──
// Заполняется импортом CSV-шаблона, который рестораны присылают заполненным.
// Живёт отдельно от выпуска: меню переиспользуется между номерами.
model Dish {
  id            String     @id @default(cuid())
  restaurantId  String     @map("restaurant_id")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Короткий номер внутри ресторана: попадает в печатный QR (/m/<slug>/d/<code>),
  // поэтому URL остаётся коротким и код читается даже с маленькой картинки.
  code          Int
  nameRu        String     @map("name_ru")
  nameUz        String?    @map("name_uz")
  descriptionRu String?    @map("description_ru") @db.Text
  descriptionUz String?    @map("description_uz") @db.Text
  price         Int?
  category      String? // starter | main | dessert | drink
  pairsWith     String?    @map("pairs_with") // блюдо-апселл
  photo         String?
  // «Живое меню»: вертикальный ролик блюда, куда ведёт печатный QR.
  // videoPoster — последний кадр ролика, снятый при загрузке в админке:
  // он показывается до старта, поэтому само видео качается только когда
  // гость дошёл до него (у <video> стоит preload="none").
  videoUrl      String?    @map("video_url")
  videoPoster   String?    @map("video_poster")
  sortOrder     Int        @default(0) @map("sort_order")
  isActive      Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guestPhotos GuestPhoto[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("dishes")
}

// ── Кадр гостя ──
// Награда за кадр — печать в следующем номере, поэтому статусы ведут
// от модерации до попадания в выпуск.
model GuestPhoto {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId       String?    @map("dish_id")
  dish         Dish?      @relation(fields: [dishId], references: [id], onDelete: SetNull)
  guestName    String?    @map("guest_name")
  guestHandle  String?    @map("guest_handle")
  imageUrl     String     @map("image_url")
  // Публикуем фото гостя в печати — без явного согласия кадр не модерируется
  consent      Boolean    @default(false)
  status       String     @default("pending") // pending | approved | printed | rejected
  sessionId    String     @map("session_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([restaurantId, status])
  @@map("guest_photos")
}

// ── Рецепт-CMS ──
// Веб-страницы рецептов достижимы по QR из журнала. Ключевая механика —
// «собрать набор микрозелени» одним тапом в корзину магазина.
model Recipe {
  id            String  @id @default(cuid())
  slug          String  @unique
  titleRu       String  @map("title_ru")
  titleUz       String? @map("title_uz")
  descriptionRu String? @map("description_ru") @db.Text
  descriptionUz String? @map("description_uz") @db.Text
  heroImage     String? @map("hero_image")
  cookMinutes   Int?    @map("cook_minutes")
  servings      Int?
  isActive      Boolean @default(true) @map("is_active")
  sortOrder     Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  steps       RecipeStep[]
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeStep {
  id           String  @id @default(cuid())
  recipeId     String  @map("recipe_id")
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order        Int
  textRu       String  @map("text_ru") @db.Text
  textUz       String? @map("text_uz") @db.Text
  image        String?
  // Таймер шага в секундах (варка/настаивание): на странице — кнопка-таймер
  timerSeconds Int?    @map("timer_seconds")

  @@index([recipeId])
  @@map("recipe_steps")
}

model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String   @map("recipe_id")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order     Int
  nameRu    String   @map("name_ru")
  nameUz    String?  @map("name_uz")
  amount    String? // «20 г», «пучок»
  // Ссылка на товар магазина заполнена только для продаваемого (микрозелень) —
  // именно эти ингредиенты уходят в кнопку «собрать набор».
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

// Payme JSON-RPC transaction log for certification compliance.
// Tracks Create → Perform / Cancel lifecycle by Payme transaction id.
model PaymeTransaction {
  id          String    @id @default(cuid())
  paymeId     String    @unique @map("payme_id") // Payme's transaction id
  orderRef    String    @map("order_ref") // our order_id / order_number
  amount      Int // tiyin (1 so'm = 100)
  state       Int       @default(1) // 1=created, 2=performed, -1=cancelled, -2=cancelled after perform
  reason      Int? // cancel reason code
  createTime  DateTime  @default(now()) @map("create_time")
  performTime DateTime? @map("perform_time")
  cancelTime  DateTime? @map("cancel_time")

  @@index([orderRef])
  @@map("payme_transactions")
}

// ==========================================
// CRM SYSTEM (AI Office — bots use raw SQL)
// ==========================================
// Эти модели зеркалят init.sql: боты обращаются к ним напрямую через
// SQLAlchemy text(), поэтому имена таблиц и колонок ДОЛЖНЫ совпадать
// с init.sql один-к-одному. Prisma владеет схемой, init.sql отмирает.

model Customer {
  id               Int       @id @default(autoincrement())
  name             String?   @db.VarChar(255)
  phone            String?   @db.VarChar(20)
  telegramId       BigInt?   @unique @map("telegram_id")
  telegramUsername String?   @map("telegram_username") @db.VarChar(255)
  email            String?   @db.VarChar(255)
  customerType     String    @default("b2c") @map("customer_type") @db.VarChar(10)
  companyName      String?   @map("company_name") @db.VarChar(255)
  companyType      String?   @map("company_type") @db.VarChar(50)
  address          String?   @db.Text
  city             String    @default("Samarqand") @db.VarChar(100)
  language         String    @default("ru") @db.VarChar(5)
  totalSpent       Decimal   @default(0) @map("total_spent") @db.Decimal(15, 2)
  bonusBalance     Decimal   @default(0) @map("bonus_balance") @db.Decimal(15, 2)
  ordersCount      Int       @default(0) @map("orders_count")
  lastOrderDate    DateTime? @map("last_order_date")
  status           String    @default("lead") @db.VarChar(20)
  notes            String?   @db.Text
  // Лид-генерация
  source           String?   @db.VarChar(50)
  sourceRef        String?   @map("source_ref") @db.VarChar(150)
  reviewScore      Decimal?  @map("review_score") @db.Decimal(2, 1)
  reviewSummary    String?   @map("review_summary") @db.Text
  // Связь с веб-пользователем (User) для объединения профилей
  webUserId        String?   @unique @map("web_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  crmOrders    CrmOrder[]
  interactions Interaction[]
  followups    Followup[]

  @@index([telegramId])
  @@index([phone])
  @@index([status])
  @@index([customerType])
  @@index([city])
  @@map("customers")
}

model CrmProduct {
  id            Int      @id @default(autoincrement())
  nameUz        String   @map("name_uz") @db.VarChar(255)
  nameRu        String   @map("name_ru") @db.VarChar(255)
  category      String   @db.VarChar(50)
  price         Decimal  @db.Decimal(12, 2)
  oldPrice      Decimal? @map("old_price") @db.Decimal(12, 2)
  unit          String   @db.VarChar(20)
  stockQty      Decimal  @default(0) @map("stock_qty") @db.Decimal(10, 2)
  minOrderQty   Decimal  @default(0.1) @map("min_order_qty") @db.Decimal(10, 2)
  imageUrl      String?  @map("image_url") @db.Text
  descriptionUz String?  @map("description_uz") @db.Text
  descriptionRu String?  @map("description_ru") @db.Text
  nutritionInfo Json?    @map("nutrition_info")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  storefrontId  String?  @map("storefront_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  crmOrderItems CrmOrderItem[]

  @@index([category])
  @@index([isActive])
  @@index([sortOrder])
  @@map("crm_products")
}

model CrmOrder {
  id               Int       @id @default(autoincrement())
  customerId       Int       @map("customer_id")
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderNumber      String?   @unique @map("order_number") @db.VarChar(20)
  totalAmount      Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  deliveryFee      Decimal   @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  discountAmount   Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  status           String    @default("new") @db.VarChar(20)
  paymentStatus    String    @default("pending") @map("payment_status") @db.VarChar(20)
  paymentMethod    String?   @map("payment_method") @db.VarChar(20)
  deliveryAddress  String?   @map("delivery_address") @db.Text
  deliveryDate     DateTime? @map("delivery_date") @db.Date
  deliveryTimeSlot String?   @map("delivery_time_slot") @db.VarChar(50)
  courierId        Int?      @map("courier_id")
  notes            String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  items        CrmOrderItem[]
  interactions Interaction[]
  finances     Finance[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([deliveryDate])
  @@index([createdAt])
  @@map("crm_orders")
}

model CrmOrderItem {
  id         Int        @id @default(autoincrement())
  orderId    Int        @map("order_id")
  order      CrmOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int        @map("product_id")
  product    CrmProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity   Decimal    @db.Decimal(10, 2)
  unit       String     @db.VarChar(20)
  unitPrice  Decimal    @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal    @map("total_price") @db.Decimal(12, 2)

  @@map("crm_order_items")
}

model Interaction {
  id              Int       @id @default(autoincrement())
  customerId      Int?      @map("customer_id")
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId         Int?      @map("order_id")
  order           CrmOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel         String    @default("telegram") @db.VarChar(20)
  interactionType String    @map("interaction_type") @db.VarChar(30)
  botName         String?   @map("bot_name") @db.VarChar(50)
  summary         String?   @db.Text
  resolved        Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([customerId])
  @@index([createdAt])
  @@index([botName])
  @@map("interactions")
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(500)
  assignee    String?   @db.VarChar(255)
  department  String?   @db.VarChar(50)
  status      String    @default("todo") @db.VarChar(20)
  priority    String    @default("medium") @db.VarChar(10)
  deadline    DateTime? @db.Date
  description String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Не @updatedAt: боты пишут статус сырым SQL, а @updatedAt Prisma
  // проставляет на стороне клиента — колонка бы застыла на дате создания.
  // Значение выставляет shared/tasks_repo.py при каждой смене статуса.
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([status])
  @@index([assignee])
  @@index([priority])
  @@index([deadline])
  @@map("tasks")
}

model Finance {
  id             Int       @id @default(autoincrement())
  type           String    @db.VarChar(10)
  amount         Decimal   @db.Decimal(15, 2)
  category       String    @db.VarChar(50)
  description    String?   @db.Text
  relatedOrderId Int?      @map("related_order_id")
  relatedOrder   CrmOrder? @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)
  receiptUrl     String?   @map("receipt_url") @db.Text
  date           DateTime  @default(now()) @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([date])
  @@index([category])
  @@index([relatedOrderId])
  @@map("finances")
}

model CrmEmployee {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  role       String   @db.VarChar(50)
  phone      String?  @db.VarChar(20)
  telegramId BigInt?  @map("telegram_id")
  status     String   @default("active") @db.VarChar(20)
  salary     Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([telegramId])
  @@index([status])
  @@map("crm_employees")
}

/// Заявки на подтверждение владельца: что бот хочет сделать и ждёт решения.
///
/// Раньше заявка жила ТОЛЬКО в Redis с TTL 15 минут. Не нажал за четверть
/// часа — ключ истекал, и намерение исчезало бесследно: никто не напоминал,
/// повторов не было, задача оставалась в `todo` навсегда, а владельцу даже не
/// сообщали, что заявка вообще была. Очереди «ждёт вашего решения» не
/// существовало ни в Telegram, ни в админке.
///
/// Теперь источник правды — эта таблица. Заявка не истекает: она ждёт, пока
/// её не одобрят или не отклонят, а напоминания приходят с нарастающим
/// интервалом. Решение атомарно (UPDATE ... WHERE status='pending'), поэтому
/// двойное нажатие не выполняет действие дважды.
model OwnerApproval {
  id      Int    @id @default(autoincrement())
  token   String @unique @db.VarChar(32)
  kind    String @db.VarChar(32)
  summary String @db.Text
  payload Json

  botName String  @map("bot_name") @db.VarChar(50)
  chatId  BigInt? @map("chat_id")
  taskId  Int?    @map("task_id")

  /// pending | approved | rejected
  status String @default("pending") @db.VarChar(16)

  remindCount Int       @default(0) @map("remind_count")
  remindedAt  DateTime? @map("reminded_at")
  decidedAt   DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("owner_approvals")
}

/// Показатели сотрудников: выработка, качество, продажи.
///
/// Раньше `log_employee_kpi` писал их строкой в `tasks` со статусом `done` —
/// тем же способом, от которого уже отказались журналы ОТК и опытов. Прочитать
/// такую запись было нечем: ни один запрос её не искал, а список задач она
/// засоряла. Отдельная таблица нужна, чтобы показатель можно было поднять
/// (`get_employee_kpi`) и сравнить во времени.
model EmployeeKpi {
  id       Int     @id @default(autoincrement())
  employee String  @db.VarChar(255)
  metric   String  @db.VarChar(50)
  value    Float
  comment  String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([employee])
  @@index([metric])
  @@map("employee_kpi")
}

model Followup {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  scheduledAt DateTime @map("scheduled_at")
  message     String   @db.Text
  status      String   @default("pending") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")


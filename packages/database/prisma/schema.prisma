// ════════════════════════════════════════════════════════════════════
//  ПУЛЬТ УПРАВЛЕНИЯ — админка как центр управления платформой.
//
//  До этих таблиц бизнес-правила (цена доставки, бонусы, пороги склада,
//  45 расписаний ботов, промпты, бенчмарки петель обучения) жили
//  константами в коде: поменять их можно было только правкой файла и
//  передеплоем. Владелец не мог изменить ничего, кроме товаров и пароля.
// ════════════════════════════════════════════════════════════════════

/// Значение любой бизнес-настройки. Ключи и дефолты объявлены в
/// apps/web/src/lib/settings/registry.ts — таблица хранит ТОЛЬКО то, что
/// владелец изменил. Пустая таблица = поведение как до изменений.
model AppSetting {
  key      String @id @db.VarChar(100) // "delivery.fee", "bonus.referralPercent"
  value    Json
  category String @db.VarChar(50) // delivery | contacts | bonus | stock | ai | bots | content

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@index([category])
  @@map("app_settings")
}

/// Журнал действий для просмотра в админке. Дублирует JSONL-файл из
/// lib/audit.ts: файл остаётся доказательством неподделываемости (цепочка
/// HMAC), а таблица нужна, чтобы журнал можно было листать и фильтровать.
model AuditLog {
  id     BigInt   @id @default(autoincrement())
  ts     DateTime @default(now()) @db.Timestamptz
  action String   @db.VarChar(100) // login.success, product.update, bot.action
  actor  String?  @db.VarChar(100) // owner, имя продавца, stepan, bot
  role   String?  @db.VarChar(32)
  ip     String?  @db.VarChar(64)
  target String?  @db.VarChar(255)
  meta   Json?

  @@index([ts])
  @@index([action])
  @@index([actor])
  @@map("audit_log")
}

/// Расписание фоновой задачи бота. Код регистрирует задачу со своим
/// дефолтом, строка здесь его перекрывает — включая enabled=false, чтобы
/// задачу можно было выключить из админки без правки Python.
model BotJob {
  id   String @id @default(cuid())
  bot  String @db.VarChar(50)
  name String @db.VarChar(100)
  kind String @db.VarChar(16) // "cron" | "interval"

  hour       Int?
  minute     Int?
  dayOfWeek  Int? @map("day_of_week") // 0=Mon .. 6=Sun
  dayOfMonth Int? @map("day_of_month")
  seconds    Int? // для kind="interval"

  enabled Boolean @default(true)

  /// Факт исполнения — админка показывает, что реально отработало.
  lastRunAt  DateTime? @map("last_run_at")
  lastStatus String?   @map("last_status") @db.VarChar(16) // ok | error
  lastError  String?   @map("last_error") @db.Text

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([bot, name])
  @@index([bot])
  @@map("bot_jobs")
}

/// Редактируемый текст промпта или JSON бенчмарков петли обучения.
/// Дефолт остаётся в Python — строка здесь его перекрывает.
model BotPrompt {
  id   String @id @default(cuid())
  bot  String @db.VarChar(50)
  key  String @db.VarChar(100) // "feedback.system", "bench.daily_pnl"
  text String @db.Text

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(100)

  @@unique([bot, key])
  @@index([bot])
  @@map("bot_prompts")
}

/// Замер метрики петли обратной связи. До этой таблицы
/// feedback_loop.record_measurement() только писал в лог — история
/// измерений нигде не сохранялась, и построить график было не из чего.
model BotMeasurement {
  id     BigInt   @id @default(autoincrement())
  bot    String   @db.VarChar(50)
  metric String   @db.VarChar(50)
  value  Float
  target Float?
  ctx    Json?    @map("context")
  ts     DateTime @default(now()) @db.Timestamptz

  @@index([bot, metric, ts])
  @@map("bot_measurements")
}

/// Партия посадки микрозелени. До этой таблицы вкладка «Посадки» держала
/// партии в localStorage браузера: смена устройства или очистка кэша
/// стирала весь производственный план, и с телефона его не было видно.
model GrowBatch {
  city        String    @default("tashkent")
  id       String @id @default(cuid())
  cropType String @map("crop_type") @db.VarChar(50)
  trays    Int    @default(1)

  seedDate  DateTime @map("seed_date") @db.Date
  darkDays  Int      @map("dark_days")
  lightDays Int      @map("light_days")
  shelfDays Int      @map("shelf_days")

  /// dark | light | ready | harvested | expired — вычисляется из дат,
  /// хранится только необратимое состояние (harvested).
  status String  @default("dark") @db.VarChar(16)
  note   String? @db.Text

  harvestDate DateTime? @map("harvest_date") @db.Date
  harvestQty  Float?    @map("harvest_qty")
  /// Себестоимость ЕДИНИЦЫ урожая = (seedCost + suppliesCost) / harvestQty.
  /// Считается сервером при сборе; до сбора пусто.
  costPrice   Float?    @map("cost_price")
  productId   String?   @map("product_id")
  productName String?   @map("product_name") @db.VarChar(255)

  // ── Себестоимость партии ──
  // Заполняется при посадке, из фактически списанного сырья по его
  // средневзвешенной цене. Раньше `cost_price` вообще не сохранялся при
  // создании партии, поэтому «убыток» просроченной партии всегда был нулём.
  seedCost     Decimal? @map("seed_cost") @db.Decimal(14, 2)
  suppliesCost Decimal? @map("supplies_cost") @db.Decimal(14, 2)
  /// Плановый выход по норме культуры — чтобы видеть отклонение факта.
  plannedYield Decimal? @map("planned_yield") @db.Decimal(10, 2)

  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")
  QualityControl QualityControl[]
  Experiment     Experiment[]
  materialUsage  RawMaterialMovement[]

  @@index([status])
  @@index([seedDate])
  @@map("grow_batches")
}

/// Разговор владельца с ассистентом Стёпаном — общий для всех каналов.
///
/// Раньше история жила отдельно в каждом канале и умирала вместе с ним:
/// в админке — в состоянии React-компонента (перезагрузка вкладки стирала
/// контекст), в Telegram — в FSM-состоянии aiogram. Начатый голосом
/// разговор не был виден в вебе, и наоборот.
///
/// Ключ — владелец, а не канал. Сейчас владелец один, поэтому ownerKey —
/// константа. Когда администраторов станет несколько, сюда придёт их
/// идентификатор, и связать каналы поможет Employee.telegramId.
model AssistantConversation {
  id       String @id @default(cuid())
  ownerKey String @map("owner_key") @db.VarChar(64)

  /// Короткое название темы. Не обязательно: нить может быть безымянной.
  title String? @db.VarChar(255)

  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz
  /// Проставляется, когда владелец начинает новую тему. Прошлые нити не
  /// удаляются — историю, которую можно подчистить, нельзя разбирать.
  endedAt   DateTime? @map("ended_at") @db.Timestamptz

  messages AssistantMessage[]

  @@index([ownerKey, startedAt])
  @@map("assistant_conversations")
}

/// Одна реплика разговора владельца с ассистентом.
model AssistantMessage {
  id             BigInt                @id @default(autoincrement())
  conversationId String                @map("conversation_id")
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// user | assistant
  role    String @db.VarChar(16)
  content String @db.Text

  /// web | telegram — где прозвучала реплика.
  channel String @db.VarChar(16)

  /// Что ассистент выполнил в ответ: название действия, итог, признак
  /// отказа. Отказ обязан остаться видимым отказом, а не исчезнуть.
  toolCalls Json? @map("tool_calls")

  /// Момент записи на сервере, а не на устройстве: владелец может писать
  /// с телефона и ноутбука одновременно, а часы у них расходятся.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// Сигнал владельцу от ИИ-офиса: аномалия, отказ, требующее внимания событие.
///
/// У Стёпана дюжина расписаний — проверка здоровья ботов каждые пять минут,
/// KPI-watchdog, бекап, дедлайны. Всё это доходило только в Telegram: если
/// владелец работал в админке, он о проблеме не узнавал. Теперь сигнал
/// кладётся сюда, и его видят оба канала.
///
/// Правило: сообщать не голый факт, а факт и что с ним делать. Поэтому
/// рядом с текстом лежит действие, которое владелец может запустить одной
/// кнопкой — оно уходит в тот же путь с подтверждением, что и остальные.
model OwnerAlert {
  id BigInt @id @default(autoincrement())

  /// bot_down | kpi_drop | backup_failed | stock_low | deadline — вид сигнала.
  kind String @db.VarChar(48)

  /// info | warning | critical
  severity String @default("warning") @db.VarChar(16)

  title   String @db.VarChar(255)
  message String @db.Text

  /// Кто поднял тревогу: stepan_bot, devops_bot, analytics_bot.
  source String @db.VarChar(48)

  /// Предлагаемое действие в терминах пульта: {action, bot}. Пусто, если
  /// сигнал только информирует.
  suggestedAction Json? @map("suggested_action")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// Проставляется, когда владелец сигнал увидел. Не удаляем: история
  /// аномалий нужна, чтобы отличить разовый сбой от постоянного.
  readAt    DateTime? @map("read_at") @db.Timestamptz

  @@index([readAt, createdAt])
  @@index([kind])
  @@map("owner_alerts")
}

// ==========================================
// Подписка «Зелёная Коробка» — еженедельная/двухнедельная доставка
// ==========================================

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionInterval {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model GreenBoxSubscription {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  status   SubscriptionStatus   @default(ACTIVE)
  interval SubscriptionInterval @default(WEEKLY)

  /// День недели доставки: 0=Пн, 1=Вт, …, 6=Вс
  deliveryDay Int    @default(1) @map("delivery_day")
  address     String
  phone       String
  city        String @default("tashkent")

  /// Дата следующей автоматической доставки
  nextDelivery DateTime @map("next_delivery") @db.Date

  /// Сумма по подписке (пересчитывается при изменении состава)
  total Int @default(0)

  note String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  pausedAt  DateTime? @map("paused_at")

  items GreenBoxItem[]

  @@index([userId])
  @@index([status, nextDelivery])
  @@map("green_box_subscriptions")
}

model GreenBoxItem {
  id             String               @id @default(cuid())
  subscriptionId String               @map("subscription_id")
  subscription   GreenBoxSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String               @map("product_id")
  product        Product              @relation(fields: [productId], references: [id])
  quantity       Int                  @default(1)

  @@unique([subscriptionId, productId])
  @@map("green_box_items")
}

// --- PHASE 4: PRODUCTION & LOGISTICS ---

model DeliveryRoute {
  city        String    @default("tashkent")
  id        String         @id @default(cuid())
  driverId  String?        @map("driver_id")
  driver    Employee?      @relation(fields: [driverId], references: [id])
  date      DateTime       @db.Date
  status    String         @default("pending") @db.VarChar(20)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  stops     DeliveryStop[]

  @@map("delivery_routes")
}

model DeliveryStop {
  id         String        @id @default(cuid())
  routeId    String        @map("route_id")
  route      DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId    String?       @map("order_id")
  order      Order?        @relation(fields: [orderId], references: [id])
  address    String        @db.Text
  phone      String?       @db.VarChar(20)
  status     String        @default("pending") @db.VarChar(20)
  orderIndex Int           @default(0) @map("order_index")
  note       String?       @db.Text

  @@index([routeId])
  @@map("delivery_stops")
}

model QualityControl {
  id          String    @id @default(cuid())
  batchId     String    @map("batch_id")
  batch       GrowBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  inspectorId String?   @map("inspector_id")
  inspector   Employee? @relation(fields: [inspectorId], references: [id])
  status      String    @default("passed") @db.VarChar(20) // passed, defect, discarded
  defectType  String?   @map("defect_type") @db.VarChar(50)
  notes       String?   @db.Text
  photoUrl    String?   @map("photo_url") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([batchId])
  @@map("quality_controls")
}

model Experiment {
  id         String     @id @default(cuid())
  batchId    String?    @map("batch_id")
  batch      GrowBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  title      String     @db.VarChar(200)
  hypothesis String?    @db.Text
  result     String?    @db.Text
  status     String     @default("ongoing") @db.VarChar(20) // ongoing, success, failed
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("experiments")
}

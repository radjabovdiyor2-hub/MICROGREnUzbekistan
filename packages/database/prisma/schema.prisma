datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" = local dev; musl-openssl-3.0.x = the node:20-alpine runtime image.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// ==========================================
// Microgreen — Xo'jalik Do'koni Database Schema
// ==========================================

model Category {
  id       String     @id @default(cuid())
  nameUz   String     @map("name_uz")
  nameRu   String     @map("name_ru")
  slug     String     @unique
  icon     String?
  image    String?
  order    Int        @default(0)
  parentId String?    @map("parent_id")
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())
  nameUz        String   @map("name_uz")
  nameRu        String   @map("name_ru")
  slug          String   @unique
  descriptionUz String?  @map("description_uz") @db.Text
  descriptionRu String?  @map("description_ru") @db.Text
  price         Int // Цена в сумах
  oldPrice      Int?     @map("old_price")
  costPrice     Int?     @map("cost_price") // Закупочная цена (от поставщика)
  images        String[] // URLs
  categoryId    String   @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  stock         Int      @default(0)
  sku           String?  @unique
  brand         String?
  specs         Json? // Характеристики
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  isActive      Boolean  @default(true) @map("is_active")
  isFeatured    Boolean  @default(false) @map("is_featured")
  isOnSale      Boolean  @default(false) @map("is_on_sale")
  viewCount     Int      @default(0) @map("view_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orderItems        OrderItem[]
  cartItems         CartItem[]
  favorites         Favorite[]
  reviews           Review[]
  stockMovements    StockMovement[]
  recipeIngredients RecipeIngredient[]

  @@index([categoryId])
  @@index([categoryId, isActive])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@map("products")
}

model User {
  id           String  @id @default(cuid())
  telegramId   BigInt? @unique @map("telegram_id")
  phone        String? @unique
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  username     String?
  avatarUrl    String? @map("avatar_url")
  language     String  @default("uz")
  theme        String  @default("system") // light | dark | system
  bonusPoints  Int     @default(0) @map("bonus_points")
  referralCode String  @unique @default(cuid()) @map("referral_code")
  referredBy   String? @map("referred_by")
  role         Role    @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]
  cart      CartItem[]
  favorites Favorite[]
  reviews   Review[]
  addresses Address[]
  aiChats   AiChat[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
  MODERATOR
  SELLER
}

model Address {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String? // "Uy", "Ish", etc.
  fullAddress String  @map("full_address")
  city        String  @default("tashkent")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("addresses")
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart_items")
}

model Favorite {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("favorites")
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique @map("order_number")
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING)
  total         Int
  subtotal      Int
  deliveryFee   Int           @default(0) @map("delivery_fee")
  discount      Int           @default(0)
  city          String        @default("tashkent")
  address       String
  phone         String
  note          String?       @db.Text
  paymentMethod String        @map("payment_method") // click | payme | cash
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  // Composite indexes for the hot list queries (newest-first pagination):
  // admin list by status, a customer's own orders, and lookup by phone.
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@index([orderNumber])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Int // Цена на момент заказа

  @@map("order_items")
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  // percent (value = 1..100) | fixed (value = сумма в сумах)
  discountType String    @default("percent") @map("discount_type")
  value        Int
  minSubtotal  Int       @default(0) @map("min_subtotal")
  maxUses      Int?      @map("max_uses")
  usedCount    Int       @default(0) @map("used_count")
  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("promo_codes")
}

model Review {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int // 1-5
  comment   String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model AiChat {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String // user | assistant
  content  String @db.Text
  metadata Json? // Recommended products, etc.

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("ai_chats")
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?  @map("image_url")
  discount    Int? // Percentage
  promoCode   String?  @unique @map("promo_code")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("promotions")
}

// ==========================================
// EMPLOYEE (SELLER) SYSTEM
// ==========================================

model Employee {
  id         String  @id @default(cuid())
  name       String
  pin        String  @unique // 4-digit PIN for POS login
  phone      String?
  telegramId BigInt? @unique @map("telegram_id")
  department String? // e.g. marketing, content, hr, etc.
  isActive   Boolean @default(true) @map("is_active")
  role       String  @default("seller") // seller | manager

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

// ==========================================
// INVENTORY MANAGEMENT SYSTEM
// ==========================================

model StockMovement {
  id          String       @id @default(cuid())
  productId   String       @map("product_id")
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        MovementType
  quantity    Int // Positive for IN, negative for OUT
  reason      String? // "Продажа", "Поставка", "Списание", "Возврат", etc.
  note        String?      @db.Text
  supplierId  String?      @map("supplier_id")
  supplier    Supplier?    @relation(fields: [supplierId], references: [id])
  costPrice   Int?         @map("cost_price") // Закупочная цена за единицу
  salePrice   Int?         @map("sale_price") // Фактическая цена продажи (если отличается от product.price)
  orderId     String?      @map("order_id") // Привязка к заказу если продажа
  performedBy String?      @map("performed_by") // Кто провёл операцию

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

enum MovementType {
  IN // Приход товара
  OUT // Продажа/расход
  ADJUSTMENT // Корректировка (инвентаризация)
  RETURN // Возврат от клиента
  WRITE_OFF // Списание (брак, порча)
}

model Supplier {
  id       String  @id @default(cuid())
  name     String
  phone    String?
  address  String?
  note     String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockMovements StockMovement[]
  debts          Debt[]

  @@map("suppliers")
}

model Debt {
  id          String    @id @default(cuid())
  type        DebtType // WHO_OWES_US = нам должны, WE_OWE = мы должны
  personName  String    @map("person_name")
  phone       String?
  amount      Int // Сумма долга в сумах
  paidAmount  Int       @default(0) @map("paid_amount") // Сколько уже оплачено
  description String?   @db.Text
  dueDate     DateTime? @map("due_date")
  isPaid      Boolean   @default(false) @map("is_paid")
  supplierId  String?   @map("supplier_id")
  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  userId      String?   @map("user_id") // Привязка к клиенту

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([isPaid])
  @@map("debts")
}

enum DebtType {
  WHO_OWES_US // Клиент должен нам
  WE_OWE // Мы должны поставщику
}

// ==========================================
// MAGAZINE SYSTEM (FRESH WEEKLY)
// ==========================================

model MagazineSubscriber {
  id      String  @id @default(cuid())
  userId  String? @map("user_id")
  phone   String?
  type    String  @default("digital") // digital | print
  address String? // Для печатной версии (print-on-demand)
  isPaid  Boolean @default(false) @map("is_paid")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("magazine_subscribers")
}

// ==========================================
// RESTAURANT DATABASE (100 ресторанов для AI Sales Bot)
// ==========================================

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  city        String // "tashkent" | "samarkand"
  cuisine     String[] // ["european", "japanese", "uzbek"]
  tier        String // "premium" | "traditional" | "cafe" | "tourist"
  dishes      String[] // Ключевые блюда
  microgreens String[] // Рекомендуемая микрозелень
  flowers     String[] // Рекомендуемые съедобные цветы
  isPartner   Boolean  @default(false) @map("is_partner")
  contactName String?  @map("contact_name")
  phone       String?
  note        String?  @db.Text

  // ── FRESH WEEKLY: HoReCa Edition (индивидуализация журнала) ──
  slug              String?  @unique
  logo              String? // /uploads/... логотип ресторана
  instagram         String? // @handle (ввод вручную, без парсинга)
  brandPrimary      String?  @map("brand_primary") // фирменный цвет #hex → --accent
  brandAccent       String?  @map("brand_accent") // акцентный цвет #hex → --gold
  promoCode         String?  @map("promo_code") // код для семейного QR-блока
  promoDiscount     Int?     @map("promo_discount") // % скидки
  menuItems         String[] @map("menu_items") // блюда меню для контекста ИИ
  isMagazinePartner Boolean  @default(false) @map("is_magazine_partner")

  // Готовый журнал: PDF/HTML загружается владельцем через админку
  magazinePdfUrl  String? @map("magazine_pdf_url")
  magazineHtmlUrl String? @map("magazine_html_url")

  // Карта лояльности: N штампов (за кадры) → промокод в магазин микрозелени
  loyaltyGoal          Int? @default(5) @map("loyalty_goal")
  loyaltyRewardPercent Int? @default(15) @map("loyalty_reward_percent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  magazineIssues     RestaurantIssue[]
  printSubscriptions PrintSubscription[]
  menuDishes         Dish[]
  guestPhotos        GuestPhoto[]
  loyaltyCards       LoyaltyCard[]

  @@index([city])
  @@index([isPartner])
  @@map("restaurants")
}

// Карта лояльности гостя (без регистрации: ключ — sessionId).
// Штамп даётся за снятый кадр блюда, максимум один в день.
model LoyaltyCard {
  id            String     @id @default(cuid())
  restaurantId  String     @map("restaurant_id")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessionId     String     @map("session_id")
  stamps        Int        @default(0)
  // YYYY-MM-DD последнего штампа — гейт «один штамп в день»
  lastStampedOn String?    @map("last_stamped_on")
  // Промокод-награда, выданный при достижении цели (в магазин микрозелени)
  rewardCode    String?    @map("reward_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([restaurantId, sessionId])
  @@index([restaurantId])
  @@map("loyalty_cards")
}

// ==========================================
// FRESH WEEKLY — Персональные выпуски (схема 50/50)
// ==========================================

// Общий 50%: генерится раз в неделю, одинаков для всех ресторанов
model MagazineEdition {
  id          String    @id @default(cuid())
  weekNumber  Int       @unique @map("week_number")
  title       String
  coverTheme  String?   @map("cover_theme")
  sharedSpec  Json      @default("{}") @map("shared_spec") // { blocks: Block[] }
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  issues RestaurantIssue[]

  @@map("magazine_editions")
}

// Персональный 50%: слово шефа, обложка, семейный блок — на каждый ресторан
model RestaurantIssue {
  id           String          @id @default(cuid())
  editionId    String          @map("edition_id")
  edition      MagazineEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  restaurantId String          @map("restaurant_id")
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  spec         Json            @default("{}") // { blocks: Block[] }
  status       String          @default("draft") // draft | ready | published
  webSlug      String          @unique @map("web_slug")
  pdfUrl       String?         @map("pdf_url")
  htmlUrl      String?         @map("html_url")
  publishedAt  DateTime?       @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  printOrders PrintOrder[]

  @@unique([editionId, restaurantId])
  @@index([restaurantId])
  @@map("restaurant_issues")
}

// ==========================================
// ADVERTISERS (B2B Sponsors & Partners)
// ==========================================

model Advertiser {
  id            String  @id @default(cuid())
  companyName   String  @map("company_name")
  contactPerson String? @map("contact_person")
  phone         String?
  email         String?
  status        String  @default("lead") // lead | active | past
  format        String? // cover_ar | spread | page
  notes         String? @db.Text
  amount        Int? // сумма контракта в сумах или USD

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("advertisers")
}

// ==========================================
// FRANCHISE MODULE (Multi-city AI Management)
// ==========================================

model FranchiseJournal {
  id         String @id @default(cuid())
  city       String // 'samarkand', 'bukhara', 'fergana'
  department String // 'sales', 'finance', 'pm', 'analytics'
  action     String // Краткое описание действия
  content    String @db.Text // Развернутый текст от ИИ-бота
  metrics    Json? // Структурированные данные (выручка, расходы и т.д.)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([city, createdAt])
  @@map("franchise_journals")
}

// ==========================================
// PRINT CENTER (Phase 4)
// ==========================================

model PrintSubscription {
  id             String       @id @default(cuid())
  restaurantId   String       @map("restaurant_id")
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan           String       @default("weekly") // weekly | biweekly | monthly
  copiesPerIssue Int          @map("copies_per_issue")
  pricePerCopy   Int          @map("price_per_copy") // цена ресторану за копию, UZS
  unitCost       Int          @default(0) @map("unit_cost") // себестоимость печати копии, UZS
  status         String       @default("active") // active | paused | cancelled
  startedAt      DateTime     @default(now()) @map("started_at")
  nextBillingAt  DateTime?    @map("next_billing_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  orders         PrintOrder[]

  @@index([restaurantId])
  @@map("print_subscriptions")
}

model PrintOrder {
  id                String             @id @default(cuid())
  restaurantIssueId String             @map("restaurant_issue_id")
  restaurantIssue   RestaurantIssue    @relation(fields: [restaurantIssueId], references: [id], onDelete: Cascade)
  subscriptionId    String?            @map("subscription_id")
  subscription      PrintSubscription? @relation(fields: [subscriptionId], references: [id])
  copies            Int
  unitCost          Int                @map("unit_cost")
  unitPrice         Int                @map("unit_price")
  revenue           Int // unitPrice * copies
  cost              Int // unitCost * copies
  margin            Int // revenue - cost
  status            String             @default("pending") // pending | paid | printing | shipped | delivered
  paymentProvider   String?            @map("payment_provider") // click | payme | cash
  paidAt            DateTime?          @map("paid_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([restaurantIssueId])
  @@map("print_orders")
}

// ── Аналитика журнала ──
model MagazineEvent {
  id        String   @id @default(cuid())
  type      String // page_view | qr_scan | dish_view | frame_open | photo_submitted | photo_shared
  slug      String? // webSlug выпуска (если применимо)
  dishId    String?  @map("dish_id") // id блюда (для событий меню)
  sessionId String   @map("session_id") // fingerprint сессии (анонимный)
  meta      Json? // доп. данные (язык, userAgent, и т.д.)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([slug])
  @@map("magazine_events")
}

// ── Живое меню: блюда ресторана ──
// Заполняется импортом CSV-шаблона, который рестораны присылают заполненным.
// Живёт отдельно от выпуска: меню переиспользуется между номерами.
model Dish {
  id            String     @id @default(cuid())
  restaurantId  String     @map("restaurant_id")
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // Короткий номер внутри ресторана: попадает в печатный QR (/m/<slug>/d/<code>),
  // поэтому URL остаётся коротким и код читается даже с маленькой картинки.
  code          Int
  nameRu        String     @map("name_ru")
  nameUz        String?    @map("name_uz")
  descriptionRu String?    @map("description_ru") @db.Text
  descriptionUz String?    @map("description_uz") @db.Text
  price         Int?
  category      String? // starter | main | dessert | drink
  pairsWith     String?    @map("pairs_with") // блюдо-апселл
  photo         String?
  // «Живое меню»: вертикальный ролик блюда, куда ведёт печатный QR.
  // videoPoster — последний кадр ролика, снятый при загрузке в админке:
  // он показывается до старта, поэтому само видео качается только когда
  // гость дошёл до него (у <video> стоит preload="none").
  videoUrl      String?    @map("video_url")
  videoPoster   String?    @map("video_poster")
  sortOrder     Int        @default(0) @map("sort_order")
  isActive      Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  guestPhotos GuestPhoto[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
  @@map("dishes")
}

// ── Кадр гостя ──
// Награда за кадр — печать в следующем номере, поэтому статусы ведут
// от модерации до попадания в выпуск.
model GuestPhoto {
  id           String     @id @default(cuid())
  restaurantId String     @map("restaurant_id")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishId       String?    @map("dish_id")
  dish         Dish?      @relation(fields: [dishId], references: [id], onDelete: SetNull)
  guestName    String?    @map("guest_name")
  guestHandle  String?    @map("guest_handle")
  imageUrl     String     @map("image_url")
  // Публикуем фото гостя в печати — без явного согласия кадр не модерируется
  consent      Boolean    @default(false)
  status       String     @default("pending") // pending | approved | printed | rejected
  sessionId    String     @map("session_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([restaurantId, status])
  @@map("guest_photos")
}

// ── Рецепт-CMS ──
// Веб-страницы рецептов достижимы по QR из журнала. Ключевая механика —
// «собрать набор микрозелени» одним тапом в корзину магазина.
model Recipe {
  id            String  @id @default(cuid())
  slug          String  @unique
  titleRu       String  @map("title_ru")
  titleUz       String? @map("title_uz")
  descriptionRu String? @map("description_ru") @db.Text
  descriptionUz String? @map("description_uz") @db.Text
  heroImage     String? @map("hero_image")
  cookMinutes   Int?    @map("cook_minutes")
  servings      Int?
  isActive      Boolean @default(true) @map("is_active")
  sortOrder     Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  steps       RecipeStep[]
  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeStep {
  id           String  @id @default(cuid())
  recipeId     String  @map("recipe_id")
  recipe       Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order        Int
  textRu       String  @map("text_ru") @db.Text
  textUz       String? @map("text_uz") @db.Text
  image        String?
  // Таймер шага в секундах (варка/настаивание): на странице — кнопка-таймер
  timerSeconds Int?    @map("timer_seconds")

  @@index([recipeId])
  @@map("recipe_steps")
}

model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String   @map("recipe_id")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  order     Int
  nameRu    String   @map("name_ru")
  nameUz    String?  @map("name_uz")
  amount    String? // «20 г», «пучок»
  // Ссылка на товар магазина заполнена только для продаваемого (микрозелень) —
  // именно эти ингредиенты уходят в кнопку «собрать набор».
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@map("recipe_ingredients")
}

// Payme JSON-RPC transaction log for certification compliance.
// Tracks Create → Perform / Cancel lifecycle by Payme transaction id.
model PaymeTransaction {
  id              String   @id @default(cuid())
  paymeId         String   @unique @map("payme_id")  // Payme's transaction id
  orderRef        String   @map("order_ref")         // our order_id / order_number
  amount          Int                                 // tiyin (1 so'm = 100)
  state           Int      @default(1)                // 1=created, 2=performed, -1=cancelled, -2=cancelled after perform
  reason          Int?                                // cancel reason code
  createTime      DateTime @default(now()) @map("create_time")
  performTime     DateTime? @map("perform_time")
  cancelTime      DateTime? @map("cancel_time")

  @@index([orderRef])
  @@map("payme_transactions")
}

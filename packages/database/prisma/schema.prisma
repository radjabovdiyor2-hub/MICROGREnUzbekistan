  bot         String  @db.VarChar(50) // content, sales, marketing, etc.
  metric      String  @db.VarChar(50) // engagement, conversion, cac, etc.
  observation String  @db.Text // Measured result vs benchmark
  inference   String  @db.Text // AI reasoning logic and conclusion
  adjustment  Json // Dynamic behavioral parameters (prompts, weights, thresholds)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

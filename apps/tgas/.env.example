# ================================================
# Microgreen Uzbekistan — AI Сотрудники
# Переменные окружения
# ================================================

# -------- Telegram Bot Tokens (создайте через @BotFather) --------
SALES_BOT_TOKEN=your_sales_bot_token_here
SUPPORT_BOT_TOKEN=your_support_bot_token_here
MARKETING_BOT_TOKEN=your_marketing_bot_token_here
HR_BOT_TOKEN=your_hr_bot_token_here
FINANCE_BOT_TOKEN=your_finance_bot_token_here
PM_BOT_TOKEN=your_pm_bot_token_here
ANALYTICS_BOT_TOKEN=your_analytics_bot_token_here
CONTENT_BOT_TOKEN=your_content_bot_token_here

# -------- Telegram-токен Стёпана (руководитель офиса) --------
STEPAN_BOT_TOKEN=your_stepan_bot_token_here

# -------- База данных --------
# База ОДНА на витрину и на офис — `microgreen`. Отдельной `microgreen_crm`
# больше нет: схемой владеет Prisma (packages/database/prisma/schema.prisma),
# витринные и CRM-таблицы лежат рядом (products/orders против crm_products/crm_orders).
DATABASE_URL=postgresql+asyncpg://mg_user:your_db_password_here@localhost:5432/microgreen
POSTGRES_PASSWORD=your_db_password_here

# -------- Redis --------
REDIS_URL=redis://localhost:6379/0

# -------- Связь с витриной (БЕЗ НЕЁ НЕ ЗАПИШЕТСЯ НИ ОДНА ПРОДАЖА) --------
# Заказы создаёт витрина: офис ходит в её API (shared/storefront_orders.py).
# Адрес зависит от того, где поднята витрина:
#   единый прод-стек (docker-compose.prod.yml)  → http://web:3000/api
#   apps/tgas/docker-compose.yml + `npm run dev` на хосте
#                                              → http://host.docker.internal:3005/api
#   всё на хосте, без Docker                   → http://localhost:3005/api
STOREFRONT_API_URL=http://web:3000/api
# Общий секрет для вызовов офис → витрина. ДОЛЖЕН совпадать с BOT_SECRET веба,
# иначе смена статуса заказа и чтение админских роутов вернут 401.
BOT_SECRET=
# Общий секрет моста витрина → офис (/ingest/order). ДОЛЖЕН совпадать с
# INGEST_SECRET веба: при расхождении витрина создаёт заказ, а зеркало в CRM
# отвечает 401 — заказ есть на сайте, но его не видят ни боты, ни финансы.
INGEST_SECRET=
# Обратный синк статуса заказа: офис → витрина.
STOREFRONT_STATUS_URL=http://web:3000/api/orders/status
# Публичный адрес витрины — по нему строятся ссылки и кнопки в админку
# (shared/admin_links.py). STOREFRONT_API_URL сюда не годится: это внутренний
# адрес docker-сети, а Telegram требует публичный HTTPS.
PUBLIC_WEB_URL=https://microgreenuzbekistan.com

# -------- OpenAI API — единственный движок ИИ-офиса --------
# Запасного поставщика нет: пустой или неверный ключ означает, что ИИ не
# работает, и об этом придёт сигнал владельцу. Раньше в этом месте молча
# включался Gemini Flash.
OPENAI_API_KEY=your_openai_api_key_here
# Пусто = дефолт из shared/config.py (`gpt-5.5`). Дешевле: `gpt-5.4`,
# `gpt-5-mini`. Семейство `gpt-5.6-*` — закрытое превью, обычный ключ его не
# откроет.
OPENAI_MODEL=

# -------- Администраторы (Telegram ID через запятую) --------
ADMIN_TELEGRAM_IDS=123456789

# -------- Компания --------
COMPANY_NAME=Microgreen Uzbekistan
COMPANY_PHONE=+998949999599
COMPANY_WEBSITE=https://microgreenuzbekistan.com
COMPANY_CITY=Samarqand
FREE_DELIVERY_THRESHOLD=500000
DELIVERY_FEE=25000
CURRENCY=UZS

# -------- Instagram Graph API --------
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# INSTAGRAM_TOKEN_UPDATED_AT= (автоматически заполняется при обмене токена)

# -------- SMTP (отправка B2B коммерческих предложений, shared/email_sender.py) --------
# Для Gmail используйте App Password (не обычный пароль): https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# -------- n8n мост (bots/n8n_bridge) --------
N8N_ASSISTANT_WEBHOOK=http://localhost:5678/webhook/assistant
N8N_TIMEOUT=120

# -------- Telegram группа продаж (ID для уведомлений о заказах) --------
SALES_GROUP_ID=0

# -------- Геокодирование адресов клиентов (карта в веб-админке) --------
# Тот же ключ 2ГИС, что и у лид-генерации, — он же первый в каскаде
# геокодеров (shared/geo.py). Без ЛЮБОГО из ключей ниже карта клиентов
# остаётся пустой: `geocode_pass` отвечает «Ни один геокодер не настроен».
# Яндекс — второй в каскаде, по Узбекистану покрытие слабее.
YANDEX_GEOCODER_API_KEY=
# Публичный Nominatim (OpenStreetMap) — ТОЛЬКО для разработки: условия OSMF
# запрещают массовое и коммерчески-первичное использование. 1 = включить.
GEOCODER_ALLOW_NOMINATIM=0

# -------- Лид-генерация (сбор ресторанов для B2B-рассылки) --------
# 2ГИС Catalog API: https://dev.2gis.ru/  (лучшее покрытие Узбекистана)
DGIS_API_KEY=
# Google Places API (альтернатива): https://console.cloud.google.com/
GOOGLE_PLACES_API_KEY=
# Сколько холодных B2B-контактов делать в день
B2B_DAILY_LIMIT=15
LEAD_GEN_CITY=Самарканд


# -------- Внешнее хранилище бэкапов --------
# ⚠️ Пока пусто — копии базы лежат ТОЛЬКО на этом сервере и погибнут вместе
# с ним. `shared/backup.py` читает эту переменную, но её не было ни здесь,
# ни в docker-compose, поэтому предупреждение «бэкап не уехал наружу» не
# показывалось ни разу: оно выводится только при заданной переменной.
# Формат — то, что понимает copy_offsite (rsync/scp-приёмник или каталог
# смонтированного удалённого диска).
BACKUP_REMOTE_TARGET=

# -------- Прочее, что читает код офиса --------
# Ключ для отправки бэкапа наружу (см. BACKUP_REMOTE_TARGET выше).
BACKUP_SSH_KEY=
# Путь к ffmpeg для обработки видео (reels). Пусто = берётся из PATH.
FFMPEG_BIN=
# true = не публиковать в Instagram по-настоящему, только логировать.
SMM_DRY_RUN=
# Разовый скрипт get_ig_id.py (получение ID страницы Facebook/Instagram).
FB_PAGE_ID=
INSTAGRAM_USER_TOKEN=
# Доступ к прод-серверу для ssh_probe.py / ssh_stop.py (ops-скрипты).
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PASS=

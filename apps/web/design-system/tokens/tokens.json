      "xl": { "$type": "other", "$value": "0 20px 25px rgba(0, 0, 0, 0.5)" },
      "card": { "$type": "other", "$value": "0 2px 12px rgba(0, 0, 0, 0.3)" },
      "button": { "$type": "other", "$value": "0 4px 14px rgba(52, 211, 153, 0.3)" },
      "accent": { "$type": "other", "$value": "0 4px 14px rgba(255, 198, 51, 0.25)" }

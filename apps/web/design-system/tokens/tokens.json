      "bg": {
        "$type": "color",
        "$value": "#065F46"
      },
      "leaf": {
        "$type": "color",
        "$value": "#4ADE80"
      }
    },
    "surface-vibrancy": {
      "$description": "Тёмное матовое стекло под подписями поверх видео и фото блюд. Значение было продублировано константой VIBRANCY в двух файлах меню.",
      "$type": "color",
      "$value": "rgba(30, 30, 30, 0.65)"
    },
    "overlay": {
      "$description": "Каналы полупрозрачных слоёв. Прозрачность у стеклянных панелей, затемнений и теней меняется плавно от 0.03 до 0.92, поэтому именованный токен на каждое значение был бы выдумкой: композиция идёт на месте — rgba(var(--overlay-light-rgb), 0.15). Тот же приём, что у --brand-primary-rgb. Каналы не зависят от темы: эти слои лежат на собственных градиентах баннеров и карточек, а не на фоне страницы. Готовые значения для частых случаев — --bg-overlay (затемнение под модалкой) и --bg-glass (стеклянная панель).",
      "light-rgb": {
        "$type": "color",
        "$value": "255, 255, 255"
      },
      "dark-rgb": {
        "$type": "color",
        "$value": "0, 0, 0"
      }
    }

      "5": { "$type": "dimension", "$value": "1.25rem" },
      "6": { "$type": "dimension", "$value": "1.5rem" },
      "8": { "$type": "dimension", "$value": "2rem" },
      "10": { "$type": "dimension", "$value": "2.5rem" },
      "12": { "$type": "dimension", "$value": "3rem" },
      "16": { "$type": "dimension", "$value": "4rem" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "8px" },
      "md": { "$type": "dimension", "$value": "12px" },
      "lg": { "$type": "dimension", "$value": "16px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "transition": {
      "fast": { "$type": "other", "$value": "150ms cubic-bezier(0.4, 0, 0.2, 1)" },
      "normal": { "$type": "other", "$value": "250ms cubic-bezier(0.4, 0, 0.2, 1)" },
      "slow": { "$type": "other", "$value": "350ms cubic-bezier(0.4, 0, 0.2, 1)" },
      "spring": { "$type": "other", "$value": "500ms cubic-bezier(0.34, 1.56, 0.64, 1)" }
    },
    "header-height": { "$type": "dimension", "$value": "64px" },
    "bottom-nav-height": { "$type": "dimension", "$value": "68px" },
    "max-width": { "$type": "dimension", "$value": "1280px" },
    "mobile-max": { "$type": "dimension", "$value": "480px" },
    "z": {
      "dropdown": { "$type": "number", "$value": "50" },
      "header": { "$type": "number", "$value": "100" },
      "bottom-nav": { "$type": "number", "$value": "100" },
      "drawer": { "$type": "number", "$value": "150" },
      "modal": { "$type": "number", "$value": "200" },
      "toast": { "$type": "number", "$value": "300" },
      "ai-chat": { "$type": "number", "$value": "250" }
    }

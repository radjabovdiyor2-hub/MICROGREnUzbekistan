{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Microgreen Design System — single source of truth (W3C DTCG / Tokens Studio compatible). Edit here, then run `npm run tokens:build` (apps/web) to regenerate build/tokens.css, build/theme.css, build/tokens.ts. Import this file into Figma via the Tokens Studio plugin to sync Variables. See ../README.md.",

  "global": {
    "font": {
      "body": { "$type": "fontFamily", "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
      "display": { "$type": "fontFamily", "$value": "'Outfit', 'Inter', sans-serif" },
      "normal": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold": { "$type": "fontWeight", "$value": "700" },
      "extrabold": { "$type": "fontWeight", "$value": "800" }
    },
    "text": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "base": { "$type": "dimension", "$value": "1rem" },
      "lg": { "$type": "dimension", "$value": "1.125rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.5rem" },
      "3xl": { "$type": "dimension", "$value": "2rem" },
      "4xl": { "$type": "dimension", "$value": "2.5rem" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "0.75rem" },

      "secondary": { "$type": "color", "$value": "#12121F" },
      "tertiary": { "$type": "color", "$value": "#1A1A2E" },
      "card": { "$type": "color", "$value": "#16162A" },
      "elevated": { "$type": "color", "$value": "#1E1E35" },

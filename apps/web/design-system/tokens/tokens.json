    "social": {
      "$description": "Фирменные цвета чужих площадок. В палитру бренда они не входят и темой не управляются: кнопка Telegram обязана быть телеграмовской синей и в светлой теме, и в тёмной, иначе перестаёт узнаваться. Держим их токенами, чтобы значение лежало в одном месте, а не расходилось по компонентам.",
      "telegram": {
        "$type": "color",
        "$value": "#0088CC"
      },
      "telegram-bright": {
        "$type": "color",
        "$value": "#229ED9"
      },
      "instagram": {
        "$type": "color",
        "$value": "#E1306C"
      },
      "instagram-deep": {
        "$type": "color",
        "$value": "#C13584"
      },
      "instagram-purple": {
        "$type": "color",
        "$value": "#833AB4"
      },
      "telegram-hover": {
        "$type": "color",
        "$value": "#0099E6"
      },
      "instagram-amber": {
        "$type": "color",
        "$value": "#F77737"
      },
      "instagram-ring": {
        "$type": "other",
        "$value": "linear-gradient(45deg, #F09433 0%, #E6683C 25%, #DC2743 50%, #CC2366 75%, #BC1888 100%)"
      }
    },
    "editorial": {
      "$description": "Палитра FRESH WEEKLY. Золото живёт и в вёрстке журнала (.mag-doc переопределяет --gold под фирменный цвет ресторана), и на страницах сайта вокруг журнала, поэтому значение по умолчанию — здесь. Пары cover-* — заглушки обложек выпусков: у выпуска без фирменного цвета ресторана обложка рисуется этим градиентом.",
      "gold": {
        "$type": "color",
        "$value": "#C9A84C"
      },
      "gold-light": {
        "$type": "color",
        "$value": "#E8D48C"
      },
      "cover-green-deep": {
        "$type": "color",
        "$value": "#0A2A0A"
      },
      "cover-green": {
        "$type": "color",
        "$value": "#1A3A1A"
      },
      "cover-green-mid": {
        "$type": "color",
        "$value": "#2D5A27"
      },
      "cover-slate-deep": {
        "$type": "color",
        "$value": "#1A202C"
      },
      "cover-slate": {
        "$type": "color",
        "$value": "#2D3748"
      }
    },
    "accent": {
      "$description": "Декоративные акценты: концы градиентов и заливки чипов. Лежат на собственных цветных подложках, а не на фоне страницы, поэтому от темы не зависят и категорийной палитре --cat-* не принадлежат.",

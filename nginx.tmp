# Microgreen Uzbekistan — Nginx Site Config (HTTP only, no SSL yet)\n# Port 3002\n\nupstream microgreen_app {\n    server 127.0.0.1:3002;\n}\n\nserver {\n    server_name microgreenuzbekistan.com www.microgreenuzbekistan.com;\n\n    client_max_body_size 10M;\n\n    add_header X-Frame-Options "SAMEORIGIN" always;\n    add_header X-Content-Type-Options "nosniff" always;\n\n    location /.well-known/acme-challenge/ {\n        root /var/www/certbot;\n    }\n\n    location /api/ {\n        proxy_pass http://microgreen_app;\n        proxy_http_version 1.1;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    location /_next/static/ {\n        proxy_pass http://microgreen_app;\n        add_header Cache-Control "public, immutable, max-age=31536000";\n    }\n\n    location /uploads/ {\n        alias /home/ubuntu/microgreen-uploads/;\n        add_header Cache-Control "public, max-age=31536000";\n    }\n\n    location / {\n        proxy_pass http://microgreen_app;\n        proxy_http_version 1.1;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Proto $scheme;\n    }\n\n    listen 443 ssl; # managed by Certbot\n    ssl_certificate /etc/letsencrypt/live/microgreenuzbekistan.com/fullchain.pem; # managed by Certbot\n    ssl_certificate_key /etc/letsencrypt/live/microgreenuzbekistan.com/privkey.pem; # managed by Certbot\n    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot\n    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot\n\n\n}\n\n\nserver {\n    if ($host = www.microgreenuzbekistan.com) {\n        return 301 https://$host$request_uri;\n    } # managed by Certbot\n\n\n    if ($host = microgreenuzbekistan.com) {\n        return 301 https://$host$request_uri;\n    } # managed by Certbot\n\n\n    listen 80;\n    server_name microgreenuzbekistan.com www.microgreenuzbekistan.com;\n    return 404; # managed by Certbot\n\n\n\n\n}
